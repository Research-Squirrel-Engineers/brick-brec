# ======================= v0.4: FDOx-Ebene (Quelle: ZIP-Memo Pyramiden-FDOx, 2026-11-17) =======================
lrec:FDOx a owl:Class ;
    rdfs:subClassOf dcat:Dataset , prov:Entity , crmdig:D1_Digital_Object ;
    rdfs:label "FDOx (FAIR Digital Object, exchangeable; Zenodo-Record)"@de , "FDOx (FAIR digital object, exchangeable; Zenodo record)"@en ;
    rdfs:comment "Identität = Zenodo-Concept-DOI (IRI des Knotens). Titel, Beteiligte, Beziehungen und Dateien stehen in den Bundle-TTLs (data/fdox/bundles/), die Versions-DOI in data/fdox/registry_pins.csv; hier nur LREC-eigene Aussagen."@de ,
                 "Identity = Zenodo concept DOI (the node IRI). Title, people, relations and files live in the bundle TTLs (data/fdox/bundles/), the version DOI in data/fdox/registry_pins.csv; only LREC-specific statements are made here."@en .
lrec:builtBy a owl:ObjectProperty ; rdfs:subPropertyOf crm:P14_carried_out_by ; rdfs:domain lrec:LegoModel ; rdfs:range crm:E21_Person ;
    rdfs:label "gebaut von"@de , "built by"@en .
lrec:imageCount a owl:DatatypeProperty ; rdfs:domain lrec:ScanDigitization ; rdfs:range xsd:integer ; rdfs:label "Anzahl Fotos"@de , "number of photos"@en .
lrec:captureDevice a owl:DatatypeProperty ; rdfs:domain lrec:ScanDigitization ; rdfs:range xsd:string ; rdfs:label "Aufnahmegerät"@de , "capture device"@en .

ex:daria a prov:Person , crm:E21_Person ; rdfs:label "Daria Stefan (TU Wien)" ; schema:identifier <https://orcid.org/0009-0008-0586-9350> ; owl:sameAs <https://orcid.org/0009-0008-0586-9350> .
ex:flo schema:identifier <https://orcid.org/0000-0002-3246-3531> ; owl:sameAs <https://orcid.org/0000-0002-3246-3531> ;
    schema:affiliation "Research Squirrel Engineers Network / Leibniz-Zentrum für Archäologie (LEIZA)" .

ex:lego_pyramid_1 lrec:builtBy ex:flo ; dct:description "Eigenbau, kein kommerzielles Set"@de , "Self-built, no commercial set"@en .
ex:lego_pyramid_2 lrec:builtBy ex:daria ; dct:description "Eigenbau, kein kommerzielles Set; Zustimmung zur Veröffentlichung liegt vor"@de ,
    "Self-built, no commercial set; consent to publication obtained"@en .
ex:lego_pyramid_2 rdfs:label "LEGO-Modell 2: gestufte Pyramide mit Tempelaufsatz"@de , "LEGO model 2: stepped pyramid with a temple on top"@en .
ex:model2_v4 rdfs:label "Rekonstruktion Modell 2 (Version 4)"@de , "Reconstruction model 2 (version 4)"@en .

# Scan-Sitzung (beide Modelle am 2026-11-12 im Apothekertrakt, Schloss Schönbrunn, während CHNT31)
ex:scan_place a lrec:ScanLocation ;
    rdfs:label "Apothekertrakt, Schloss Schönbrunn, Wien"@de , "Apothekertrakt, Schönbrunn Palace, Vienna"@en ;
    skos:closeMatch wd:Q131330 ; geo:hasGeometry ex:scan_place_geom ;
    rdfs:seeAlso <https://www.openstreetmap.org/relation/6892072> .
ex:scan_place_geom a geo:Geometry ; geo:asWKT "POINT(16.318911 48.184424)"^^geo:wktLiteral .
ex:scan_day a lrec:ProcessInterval ; time:hasBeginning [ a time:Instant ; time:inXSDDate "2026-11-12"^^xsd:date ] ;
    rdfs:label "Scan-Sitzung (während CHNT31)"@de , "Scan session (during CHNT31)"@en .
ex:model1_scan_event a lrec:ScanDigitization ; crm:P7_took_place_at ex:scan_place ; crmdig:L1_digitized ex:lego_pyramid_1 ;
    crm:P4_has_time-span ex:scan_day ; crm:P14_carried_out_by ex:flo ; prov:generated ex:model1_scan ;
    lrec:captureDevice "Samsung Galaxy S26" ; lrec:imageCount 69 ;
    dct:description "KIRI Engine (SfM), scan at 15:46; app version not shown"@en .
ex:model2_scan_event crm:P7_took_place_at ex:scan_place ; crm:P4_has_time-span ex:scan_day ; crm:P14_carried_out_by ex:daria ; prov:generated ex:model2_scan ;
    lrec:captureDevice "Samsung Galaxy A71" ; lrec:imageCount 115 ;
    dct:description "KIRI Engine (SfM); app version not shown; scan time not recorded"@en .
ex:model1_recon_glb a lrec:ReconstructionModel ; rdfs:label "Rekonstruktion Modell 1 (lego.glb)"@de , "Reconstruction model 1 (lego.glb)"@en ;
    prov:wasDerivedFrom ex:model1_scan .
ex:lego_pyramid_1 hdt:has_3D_model ex:model1_scan , ex:model1_recon_glb .

# Builder statement as evidence
ex:ev_m2_builder a lrec:Evidence ; rdfs:label "Erbauerin bestätigt: Maya-Stufenpyramide (nicht: El Castillo), 2026-11-17"@de , "Builder confirms: Maya step pyramid (El Castillo not confirmed), 2026-11-17"@en ;
    lrec:evidenceStrength "strong" ; prov:wasAttributedTo ex:daria ; lrec:supports ex:hyp_m2_a .
ex:ident_m2 crminf:J1_used_as_premise ex:ev_m2_builder .

# --- die vier FDOx: gleiche IRI wie in den Bundle-TTLs (data/fdox/bundles/), daher verschmelzen die Knoten beim Laden ohne owl:sameAs.
# Hier steht nur, was die Bundles nicht kennen: LREC-Typ, Verbindung zu Scan-Aktivität, Modell und KI-Zuschreibung.
<https://doi.org/10.5281/zenodo.24305240> a lrec:FDOx ; prov:wasGeneratedBy ex:model1_scan_event ; hdt:has_3D_model ex:model1_scan .
<https://doi.org/10.5281/zenodo.24305343> a lrec:FDOx , lrec:ReconstructionDataset ; prov:wasAttributedTo ex:claude_sonnet_5_5 ; hdt:has_3D_model ex:model1_recon_glb .
<https://doi.org/10.5281/zenodo.24305428> a lrec:FDOx ; prov:wasGeneratedBy ex:model2_scan_event ; hdt:has_3D_model ex:model2_scan .
<https://doi.org/10.5281/zenodo.24305436> a lrec:FDOx , lrec:ReconstructionDataset ; prov:wasAttributedTo ex:claude_sonnet_5_5 ; prov:wasGeneratedBy ex:model2_recon ; hdt:has_3D_model ex:model2_v4 .
ex:model2_recon prov:used ex:model2_scan .
