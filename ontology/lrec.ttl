# ---- English labels (@en, British English) ----
unit:DEG rdfs:label "Degree"@en .
lrec:AIAssistant rdfs:label "AI assistant (software agent)"@en .
lrec:AlignmentAndMeasurement rdfs:label "Alignment and measurement"@en .
lrec:Assumption rdfs:label "Assumption"@en .
lrec:BrickType rdfs:label "Brick type"@en .
lrec:CandidateReferent rdfs:label "Candidate (possible original)"@en .
lrec:ChangeDocumentation rdfs:label "Change documentation"@en .
lrec:Evidence rdfs:label "Observation / argument"@en .
lrec:Identification rdfs:label "Identification (what does the object represent?)"@en .
lrec:IdentityHypothesis rdfs:comment "Proposal of what a model represents. Hypotheses may overlap; lrec:confidence is a subjective estimate, not a probability distribution."@en .
lrec:IdentityHypothesis rdfs:label "Identification hypothesis"@en .
lrec:LegoModel rdfs:label "LEGO model (physical)"@en .
lrec:LegoModelTwin rdfs:label "Digital twin of a LEGO model"@en .
lrec:ProceduralReconstruction rdfs:label "Procedural reconstruction"@en .
lrec:ProcessInterval rdfs:label "Time interval of a process"@en .
lrec:QualityMeasurement rdfs:label "Quality measurement"@en .
lrec:RawScan rdfs:label "SfM raw scan"@en .
lrec:ReconstructionDataset rdfs:comment "Dataset wrapper around the GLB, documentation and scripts; the distribution is lrec:ReconstructionModel."@en .
lrec:ReconstructionDataset rdfs:label "Reconstruction dataset (DCAT-AP)"@en .
lrec:ReconstructionModel rdfs:label "Reconstruction model (GLB)"@en .
lrec:ReconstructionScript rdfs:label "Reconstruction script (CodeMeta)"@en .
lrec:ReferencePhoto rdfs:label "Reference photo"@en .
lrec:ScanDigitization rdfs:label "Scan digitisation"@en .
lrec:ScanLocation rdfs:label "Capture location"@en .
lrec:StructureInference rdfs:label "Structure inference"@en .
lrec:confidence rdfs:comment "Estimated reliability between 0 and 1."@en .
lrec:hypothesisAbout rdfs:comment "The LEGO object the hypothesis refers to."@en .
lrec:knownDeviation rdfs:comment "Documented deviation from the photo or the original."@en .
lrec:proposesReferent rdfs:comment "Proposed original; analogous to crm:P62_depicts, but explicitly only a hypothesis."@en .
lrec:wikidataSearchTerm rdfs:comment "Search term for wikidata_match.py; the QID is entered as skos:closeMatch only after checking."@en .
<https://example.org/lego-reconstruction> dct:description "Connects CIDOC CRM (+ CRMdig, CRMinf), PROV-O, DCAT/DCAT-AP, DQV, CodeMeta, OWL-Time, GeoSPARQL, SKOS and Wikidata for documenting scan reconstructions."@en .
<https://example.org/lego-reconstruction> dct:title "Mini ontology: from SfM scan to reconstruction"@en .
