@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix unit:   <http://qudt.org/vocab/unit/> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix hdt:    <https://example.org/placeholder/hdt#> .   # Platzhalter: durch den offiziellen HDT-Namespace ersetzen
@prefix dqv:    <http://www.w3.org/ns/dqv#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix schema: <https://schema.org/> .
@prefix codemeta: <https://w3id.org/codemeta/> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix geo:    <http://www.opengis.net/ont/geosparql#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix lrec:   <https://example.org/lego-reconstruction#> .
@prefix ex:     <https://example.org/lego-reconstruction/id/> .

<https://example.org/lego-reconstruction> a owl:Ontology ;
    dct:title "Mini-Ontologie: vom SfM-Scan zur Rekonstruktion"@de ;
    dct:description "Verbindet CIDOC CRM (+ CRMdig, CRMinf), PROV-O, DCAT/DCAT-AP, DQV, CodeMeta, OWL-Time, GeoSPARQL, SKOS und Wikidata für die Dokumentation von Scan-Rekonstruktionen."@de ;
    owl:versionInfo "0.4" ;
    owl:imports <http://www.cidoc-crm.org/cidoc-crm/> , <http://www.w3.org/ns/prov-o#> .

# ---- Klassen (alle als Unterklassen bestehender Ontologien) ----
lrec:ScanDigitization a owl:Class ;
    rdfs:subClassOf crmdig:D2_Digitization_Process , hdt:HC_Heritage_Documenting , prov:Activity ;
    rdfs:label "Scan-Digitalisierung"@de .
lrec:RawScan a owl:Class ;
    rdfs:subClassOf crmdig:D1_Digital_Object , hdt:HC_3D_Model , prov:Entity ;
    rdfs:label "SfM-Rohscan"@de .
lrec:AlignmentAndMeasurement a owl:Class ;
    rdfs:subClassOf crm:E16_Measurement , crmdig:D7_Digital_Machine_Event , prov:Activity ;
    rdfs:label "Ausrichtung und Vermessung"@de .
lrec:StructureInference a owl:Class ;
    rdfs:subClassOf crminf:I5_Inference_Making , prov:Activity ;
    rdfs:label "Strukturableitung"@de .
lrec:Assumption a owl:Class ;
    rdfs:subClassOf crminf:I2_Belief , prov:Entity ;
    rdfs:label "Annahme"@de .
lrec:ProceduralReconstruction a owl:Class ;
    rdfs:subClassOf crmdig:D7_Digital_Machine_Event , prov:Activity ;
    rdfs:label "Prozedurale Rekonstruktion"@de .
lrec:ReconstructionModel a owl:Class ;
    rdfs:subClassOf crmdig:D1_Digital_Object , hdt:HC_3D_Model , prov:Entity , dcat:Distribution ;
    rdfs:label "Rekonstruktionsmodell (GLB)"@de .
lrec:ChangeDocumentation a owl:Class ;
    rdfs:subClassOf crm:E31_Document , hdt:HC_Heritage_Document , prov:Entity ;
    rdfs:label "Änderungsdokumentation"@de .
lrec:BrickType a owl:Class ;
    rdfs:subClassOf crm:E55_Type , skos:Concept ;
    rdfs:label "Steintyp"@de .

lrec:LegoModelTwin a owl:Class ;
    rdfs:subClassOf hdt:HC_Heritage_Digital_Twin , crmdig:D1_Digital_Object ;
    rdfs:label "Digitaler Zwilling eines LEGO-Modells"@de .
lrec:LegoModel a owl:Class ;
    rdfs:subClassOf hdt:HC_Tangible_Asset , crm:E22_Human-Made_Object ;
    rdfs:label "LEGO-Modell (physisch)"@de .

# ---- v0.2: neue Klassen ----
lrec:ReconstructionDataset a owl:Class ;
    rdfs:subClassOf dcat:Dataset , prov:Entity , crmdig:D1_Digital_Object ;
    rdfs:label "Rekonstruktions-Datensatz (DCAT-AP)"@de ;
    rdfs:comment "Datensatz-Hülle um GLB, Doku und Skripte; Distribution ist lrec:ReconstructionModel."@de .
lrec:QualityMeasurement a owl:Class ;
    rdfs:subClassOf dqv:QualityMeasurement , crm:E54_Dimension ;
    rdfs:label "Qualitätsmessung"@de .
lrec:ReconstructionScript a owl:Class ;
    rdfs:subClassOf crmdig:D14_Software , schema:SoftwareSourceCode , prov:Entity ;
    rdfs:label "Rekonstruktionsskript (CodeMeta)"@de .
lrec:ProcessInterval a owl:Class ;
    rdfs:subClassOf crm:E52_Time-Span , time:ProperInterval ;
    rdfs:label "Zeitraum eines Prozesses"@de .
lrec:ScanLocation a owl:Class ;
    rdfs:subClassOf crm:E53_Place , geo:Feature ;
    rdfs:label "Ort der Aufnahme"@de .

lrec:ReferencePhoto a owl:Class ;
    rdfs:subClassOf crmdig:D1_Digital_Object , hdt:HC_Imagery , prov:Entity ;
    rdfs:label "Referenzfoto"@de .

# ---- Eigenschaften ----
lrec:usesScript a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain lrec:ProceduralReconstruction ; rdfs:range lrec:ReconstructionScript .
lrec:usesAssumption a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain lrec:ProceduralReconstruction ; rdfs:range lrec:Assumption .
lrec:knownDeviation a owl:DatatypeProperty ;
    rdfs:domain lrec:ReconstructionModel ; rdfs:range xsd:string ;
    rdfs:comment "Dokumentierte Abweichung von Foto oder Original."@de .
lrec:confidence a owl:DatatypeProperty ;
    rdfs:domain lrec:Assumption ; rdfs:range xsd:decimal ;
    rdfs:comment "Geschätzte Verlässlichkeit zwischen 0 und 1."@de .

# ---- HDT-Eigenschaften (Namen nach Niccolucci et al., Data 2022; Namespace Platzhalter) ----
hdt:has_digital_twin a owl:ObjectProperty ; rdfs:label "has digital twin" .
hdt:includes_3D_documentation a owl:ObjectProperty ; rdfs:label "includes 3D documentation" .
hdt:includes_visual_documentation a owl:ObjectProperty ; rdfs:label "includes visual documentation" .
hdt:includes_document a owl:ObjectProperty ; rdfs:label "includes document" .
hdt:has_3D_model a owl:ObjectProperty ; rdfs:label "has 3D model" .

# ---- Beteiligte (PROV-O + CRM) ----
lrec:AIAssistant a owl:Class ;
    rdfs:subClassOf prov:SoftwareAgent , crm:E39_Actor ;
    rdfs:label "KI-Assistent (Software-Agent)"@de .
ex:flo a prov:Person , crm:E21_Person ; rdfs:label "Flo (RSE, LEIZA)" .
ex:claude_sonnet_5_5 a lrec:AIAssistant ;
    rdfs:label "Claude Sonnet 5.5" ;
    dct:identifier "claude-sonnet-5-5" ;
    rdfs:comment "Konfiguriertes Modell der Sitzung; das tatsächlich bedienende Modell kann abweichen."@de ;
    prov:actedOnBehalfOf ex:flo .

# ---- Beispiel (Modell 2, Version 4) ----
ex:lego_pyramid_2 a lrec:LegoModel ; hdt:has_digital_twin ex:lego_pyramid_2_twin ;
    hdt:has_3D_model ex:model2_scan , ex:model2_v4 .
ex:lego_pyramid_2_twin a lrec:LegoModelTwin ;
    hdt:includes_3D_documentation ex:model2_scan , ex:model2_v4 ;
    hdt:includes_document ex:model2_changes .
ex:model2_changes a lrec:ChangeDocumentation ; crm:P70_documents ex:model2_recon .
ex:model2_scan a lrec:RawScan ; rdfs:label "KIRI-Rohscan Modell 2" .
ex:model2_yaw a crm:E54_Dimension ; crm:P90_has_value 16.25 ; crm:P91_has_unit unit:DEG ;
    rdfs:label "Yaw der Pyramide gegen den Boden" .
ex:model2_measure a lrec:AlignmentAndMeasurement ;
    crm:P39_measured ex:model2_scan ; crm:P40_observed_dimension ex:model2_yaw .
ex:assume_7_levels a lrec:Assumption ; lrec:confidence 0.7 ;
    rdfs:label "7 Stufen nach Foto, Scan deutet auf 8" .
ex:infer a lrec:StructureInference ;
    crminf:J1_used_as_premise ex:model2_yaw ; crminf:J2_concluded_that ex:assume_7_levels .
ex:model2_recon a lrec:ProceduralReconstruction ;
    crmdig:L10_had_input ex:model2_scan ; lrec:usesAssumption ex:assume_7_levels ;
    crmdig:L11_had_output ex:model2_v4 ;
    crm:P14_carried_out_by ex:flo , ex:claude_sonnet_5_5 ;
    prov:wasAssociatedWith ex:flo , ex:claude_sonnet_5_5 ; prov:startedAtTime "2026-11-12T20:00:00+01:00"^^xsd:dateTime .
ex:model2_v4 a lrec:ReconstructionModel ;
    crmdig:L21_used_as_derivation_source ex:model2_scan ;
    prov:wasDerivedFrom ex:model2_scan ; prov:wasGeneratedBy ex:model2_recon ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/model/gltf-binary> ;
    lrec:knownDeviation "Einzelne 1x2/1x4-Steine wegen ungerader Flächen" .

# ---- v0.2: Beispiele ----
ex:model2_dataset a lrec:ReconstructionDataset ;
    dct:title "LEGO-Pyramide 2, Rekonstruktion v4"@de ;
    dct:description "GLB-Modell, Änderungsdokumentation und Skript."@de ;
    dct:conformsTo <http://data.europa.eu/r5r/> ;
    dcat:distribution ex:model2_v4 ; prov:wasDerivedFrom ex:model2_scan .
ex:model2_v4 dct:format <http://publications.europa.eu/resource/authority/file-type/GLB> .
ex:build_m3 a lrec:ReconstructionScript ;
    schema:name "build_m3.py" ; schema:programmingLanguage "Python" ;
    codemeta:developmentStatus "wip" ;
    schema:codeRepository <https://example.org/TODO-repository> .
ex:model2_recon lrec:usesScript ex:build_m3 ;
    crmdig:L23_used_software_or_firmware ex:build_m3 ;
    crm:P4_has_time-span ex:model2_time .
ex:model2_time a lrec:ProcessInterval ;
    time:hasBeginning [ a time:Instant ; time:inXSDDateTimeStamp "2026-11-12T20:00:00+01:00"^^xsd:dateTimeStamp ] .
ex:metric_levels a dqv:Metric ; skos:prefLabel "Anzahl Stufen"@de ;
    dqv:inDimension ex:dim_consistency ; dqv:expectedDataType xsd:integer .
ex:dim_consistency a dqv:Dimension ; skos:prefLabel "Konsistenz mit Foto"@de .
ex:quality_levels a lrec:QualityMeasurement ;
    dqv:computedOn ex:model2_v4 ; dqv:isMeasurementOf ex:metric_levels ; dqv:value 7 .
ex:model2_v4 dqv:hasQualityMeasurement ex:quality_levels .
ex:scan_place a lrec:ScanLocation ; rdfs:label "Aufnahmeort (Geometrie offen)"@de .
ex:model2_scan_event a lrec:ScanDigitization ; crm:P7_took_place_at ex:scan_place ;
    crmdig:L1_digitized ex:lego_pyramid_2 .
ex:brick_scheme a skos:ConceptScheme ; skos:prefLabel "LEGO-Steintypen"@de .
ex:brick_2x4 a lrec:BrickType ; skos:prefLabel "2x4"@de ; skos:inScheme ex:brick_scheme .
ex:brick_2x2 a lrec:BrickType ; skos:prefLabel "2x2"@de ; skos:inScheme ex:brick_scheme .
ex:brick_1x1 a lrec:BrickType ; skos:prefLabel "1x1"@de ; skos:inScheme ex:brick_scheme .
# Wikidata-Verknüpfungen (skos:exactMatch / owl:sameAs): siehe wikidata_mapping.ttl, erzeugt von wikidata_match.py

# ---- v0.2 Abgleich mit der Gesamtzeichnung: Fotos, Geraet, KIRI, Einheit, Typ ----
ex:model2_photos a lrec:ReferencePhoto ; rdfs:label "Referenzfotos Modell 2"@de .
ex:lego_pyramid_2_twin hdt:includes_visual_documentation ex:model2_photos .
ex:smartphone a crmdig:D8_Digital_Device ; rdfs:label "Smartphone"@de .
ex:kiri_engine a crmdig:D14_Software ; rdfs:label "KIRI Engine" .
ex:model2_scan_event crmdig:L12_happened_on_device ex:smartphone ;
    crmdig:L23_used_software_or_firmware ex:kiri_engine ;
    crmdig:L11_had_output ex:model2_scan .
ex:model2_v4 crm:P2_has_type ex:brick_2x4 , ex:brick_2x2 , ex:brick_1x1 .
unit:DEG a crm:E58_Measurement_Unit , qudt:Unit ; rdfs:label "Grad"@de .

# =====================================================================
# v0.3: Identifikation (was stellt das Objekt dar?) als CRMinf-Argumentation
# =====================================================================
lrec:Identification a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment , crminf:I5_Inference_Making , prov:Activity ;
    rdfs:label "Identifikation (Was stellt das Objekt dar?)"@de .
lrec:IdentityHypothesis a owl:Class ;
    rdfs:subClassOf lrec:Assumption ;
    rdfs:label "Identifikations-Hypothese"@de ;
    rdfs:comment "Vorschlag, was ein Modell darstellt. Hypothesen können sich überlappen; lrec:confidence ist eine subjektive Einschätzung, keine Wahrscheinlichkeitsverteilung."@de .
lrec:Evidence a owl:Class ;
    rdfs:subClassOf crminf:I4_Proposition_Set , prov:Entity ;
    rdfs:label "Beobachtung / Argument"@de .
lrec:CandidateReferent a owl:Class ;
    rdfs:subClassOf crm:E1_CRM_Entity ;
    rdfs:label "Kandidat (Typ oder Individuum, das dargestellt sein koennte)"@de .

lrec:hypothesisAbout a owl:ObjectProperty ; rdfs:domain lrec:IdentityHypothesis ; rdfs:range crm:E1_CRM_Entity ;
    rdfs:comment "Das LEGO-Objekt, auf das sich die Hypothese bezieht."@de .
lrec:proposesReferent a owl:ObjectProperty ; rdfs:domain lrec:IdentityHypothesis ; rdfs:range lrec:CandidateReferent ;
    rdfs:comment "Vorgeschlagenes Vorbild; analog zu crm:P62_depicts, aber ausdruecklich nur Hypothese."@de .
lrec:supports a owl:ObjectProperty ; rdfs:domain lrec:Evidence ; rdfs:range lrec:IdentityHypothesis .
lrec:weakens a owl:ObjectProperty ; rdfs:domain lrec:Evidence ; rdfs:range lrec:IdentityHypothesis .
lrec:alternativeTo a owl:ObjectProperty , owl:SymmetricProperty ; rdfs:domain lrec:IdentityHypothesis ; rdfs:range lrec:IdentityHypothesis .
lrec:specializes a owl:ObjectProperty ; rdfs:domain lrec:IdentityHypothesis ; rdfs:range lrec:IdentityHypothesis .
lrec:wikidataSearchTerm a owl:DatatypeProperty ; rdfs:domain lrec:CandidateReferent ; rdfs:range xsd:string ;
    rdfs:comment "Suchbegriff für wikidata_match.py; die QID wird als skos:closeMatch erst nach Prüfung eingetragen."@de .
lrec:confidenceBasis a owl:DatatypeProperty ; rdfs:domain lrec:Assumption ; rdfs:range xsd:string .
lrec:verificationStatus a owl:DatatypeProperty ; rdfs:domain lrec:IdentityHypothesis ; rdfs:range xsd:string .

ex:lego_pyramid_1 a lrec:LegoModel ; rdfs:label "LEGO-Modell 1: weiße Stufenpyramide mit Säule und Figur"@de .
ex:figure_1 a crm:E22_Human-Made_Object ; rdfs:label "Minifigur auf Modell 1"@de .
ex:lego_pyramid_1 crm:P46_is_composed_of ex:figure_1 .
ex:ev_m2_1 a lrec:Evidence ; rdfs:label "Gestuftes, zentriertes Pyramidenprofil, 7 Ebenen (Foto)"@de ; prov:wasDerivedFrom ex:model2_photos , ex:model2_scan .
ex:ev_m2_2 a lrec:Evidence ; rdfs:label "Vier Treppenarme aus grauen Steinen, je 4 Noppen breit, an allen vier Seiten (Foto)"@de ; prov:wasDerivedFrom ex:model2_photos , ex:model2_scan .
ex:ev_m2_3 a lrec:Evidence ; rdfs:label "Aufsatz mit vier Eckpfeilern und Dach, innen hohl: Tempel/Schrein (Foto)"@de ; prov:wasDerivedFrom ex:model2_photos , ex:model2_scan .
ex:ev_m2_4 a lrec:Evidence ; rdfs:label "Umgebung: weiße Backstein-Architekturmodelle auf Grundplatte (Foto, schwach)"@de ; prov:wasDerivedFrom ex:model2_photos , ex:model2_scan .
ex:ev_m2_5 a lrec:Evidence ; rdfs:label "Nur 7 statt 9 Ebenen, Treppenstufen nicht einzeln modelliert: stark abstrahiert"@de ; prov:wasDerivedFrom ex:model2_photos , ex:model2_scan .
ex:ev_m1_1 a lrec:Evidence ; rdfs:label "Neun gleich hohe weiße Stufen, quadratischer Grundriss (Scan)"@de ; prov:wasDerivedFrom ex:model1_photos , ex:model1_scan .
ex:ev_m1_2 a lrec:Evidence ; rdfs:label "Zentrale Säule aus 5 Steinen (1x1) auf der obersten Stufe (Scan)"@de ; prov:wasDerivedFrom ex:model1_photos , ex:model1_scan .
ex:ev_m1_3 a lrec:Evidence ; rdfs:label "Figur mit Spitzhelm, Kettenhemd, Schnurrbart und Umhang (Foto)"@de ; prov:wasDerivedFrom ex:model1_photos , ex:model1_scan .
ex:ev_m1_4 a lrec:Evidence ; rdfs:label "Figur steht einzeln und exponiert auf der Säulenspitze (Foto/Scan)"@de ; prov:wasDerivedFrom ex:model1_photos , ex:model1_scan .
ex:ev_m1_5 a lrec:Evidence ; rdfs:label "Umgebung: weiße Backstein-Architekturmodelle (Foto, schwach)"@de ; prov:wasDerivedFrom ex:model1_photos , ex:model1_scan .
ex:model1_photos a lrec:ReferencePhoto ; rdfs:label "Referenzfotos Modell 1 (Figur)"@de .
ex:model1_scan a lrec:RawScan ; rdfs:label "KIRI-Rohscan Modell 1" .
ex:c_maya a lrec:CandidateReferent ; rdfs:label "Mesoamerikanische Stufenpyramide mit Tempel"@de ; lrec:wikidataSearchTerm "Mesoamerican pyramids" .
ex:c_elcastillo a lrec:CandidateReferent ; rdfs:label "El Castillo (Pyramide des Kukulcán, Chichen Itza)"@de ; lrec:wikidataSearchTerm "El Castillo Chichen Itza" .
ex:c_angkor a lrec:CandidateReferent ; rdfs:label "Angkor-Tempelberg (z. B. Bakong)"@de ; lrec:wikidataSearchTerm "Bakong" .
ex:c_ziggurat a lrec:CandidateReferent ; rdfs:label "Zikkurat"@de ; lrec:wikidataSearchTerm "ziggurat" .
ex:c_denkmal a lrec:CandidateReferent ; rdfs:label "Denkmal / Gedenksäule"@de ; lrec:wikidataSearchTerm "memorial column" .
ex:c_wachturm a lrec:CandidateReferent ; rdfs:label "Wachturm"@de ; lrec:wikidataSearchTerm "watchtower" .
ex:c_soldier a lrec:CandidateReferent ; rdfs:label "Soldat / Krieger"@de ; lrec:wikidataSearchTerm "soldier" .
ex:c_cobi a lrec:CandidateReferent ; rdfs:label "Cobi (Spielzeughersteller, historische Figuren)"@de ; lrec:wikidataSearchTerm "Cobi" .
ex:hyp_m2_a a lrec:IdentityHypothesis ; rdfs:label "Mesoamerikanische (Maya) Stufenpyramide mit Tempelaufsatz, generisch"@de ; lrec:hypothesisAbout ex:lego_pyramid_2 ; lrec:confidence 0.7 ;
    lrec:confidenceBasis "subjektive Einschätzung des KI-Assistenten nach Sichtung von Fotos und Scan, keine Messung" ; lrec:verificationStatus "bestätigt durch den Erbauer (Daria Stefan, über Flo), 2026-11-17" ;
    lrec:proposesReferent ex:c_maya ; prov:wasAttributedTo ex:claude_sonnet_5_5 ; prov:wasGeneratedBy ex:ident_m2 .
ex:ev_m2_1 lrec:supports ex:hyp_m2_a .
ex:ev_m2_2 lrec:supports ex:hyp_m2_a .
ex:ev_m2_3 lrec:supports ex:hyp_m2_a .
ex:hyp_m2_b a lrec:IdentityHypothesis ; rdfs:label "El Castillo in Chichen Itza (Spezialfall von a)"@de ; lrec:hypothesisAbout ex:lego_pyramid_2 ; lrec:confidence 0.35 ;
    lrec:confidenceBasis "subjektive Einschätzung des KI-Assistenten nach Sichtung von Fotos und Scan, keine Messung" ; lrec:verificationStatus "vom Erbauer nicht bestätigt (nicht widerlegt), 2026-11-17" ;
    lrec:specializes ex:hyp_m2_a ;
    lrec:proposesReferent ex:c_elcastillo ; prov:wasAttributedTo ex:claude_sonnet_5_5 ; prov:wasGeneratedBy ex:ident_m2 .
ex:ev_m2_2 lrec:supports ex:hyp_m2_b .
ex:ev_m2_3 lrec:supports ex:hyp_m2_b .
ex:ev_m2_5 lrec:weakens ex:hyp_m2_b .
ex:hyp_m2_c a lrec:IdentityHypothesis ; rdfs:label "Angkor-Tempelberg mit Heiligtum"@de ; lrec:hypothesisAbout ex:lego_pyramid_2 ; lrec:confidence 0.1 ;
    lrec:confidenceBasis "subjektive Einschätzung des KI-Assistenten nach Sichtung von Fotos und Scan, keine Messung" ; lrec:verificationStatus "offen: Bestätigung durch Flo nötig" ;
    lrec:alternativeTo ex:hyp_m2_a ;
    lrec:proposesReferent ex:c_angkor ; prov:wasAttributedTo ex:claude_sonnet_5_5 ; prov:wasGeneratedBy ex:ident_m2 .
ex:ev_m2_1 lrec:supports ex:hyp_m2_c .
ex:ev_m2_2 lrec:supports ex:hyp_m2_c .
ex:ev_m2_3 lrec:weakens ex:hyp_m2_c .
ex:hyp_m2_d a lrec:IdentityHypothesis ; rdfs:label "Zikkurat mit Tempel"@de ; lrec:hypothesisAbout ex:lego_pyramid_2 ; lrec:confidence 0.08 ;
    lrec:confidenceBasis "subjektive Einschätzung des KI-Assistenten nach Sichtung von Fotos und Scan, keine Messung" ; lrec:verificationStatus "offen: Bestätigung durch Flo nötig" ;
    lrec:alternativeTo ex:hyp_m2_a ;
    lrec:proposesReferent ex:c_ziggurat ; prov:wasAttributedTo ex:claude_sonnet_5_5 ; prov:wasGeneratedBy ex:ident_m2 .
ex:ev_m2_1 lrec:supports ex:hyp_m2_d .
ex:ev_m2_3 lrec:supports ex:hyp_m2_d .
ex:ev_m2_2 lrec:weakens ex:hyp_m2_d .
ex:hyp_m2_e a lrec:IdentityHypothesis ; rdfs:label "Freies Design ohne konkretes Vorbild"@de ; lrec:hypothesisAbout ex:lego_pyramid_2 ; lrec:confidence 0.15 ;
    lrec:confidenceBasis "subjektive Einschätzung des KI-Assistenten nach Sichtung von Fotos und Scan, keine Messung" ; lrec:verificationStatus "offen: Bestätigung durch Flo nötig" ;
    lrec:alternativeTo ex:hyp_m2_a ;
     prov:wasAttributedTo ex:claude_sonnet_5_5 ; prov:wasGeneratedBy ex:ident_m2 .
ex:ev_m2_5 lrec:supports ex:hyp_m2_e .
ex:hyp_m1_a a lrec:IdentityHypothesis ; rdfs:label "Denkmal: Standbild eines Kriegers auf Säule über Stufenunterbau"@de ; lrec:hypothesisAbout ex:lego_pyramid_1 ; lrec:confidence 0.55 ;
    lrec:confidenceBasis "subjektive Einschätzung des KI-Assistenten nach Sichtung von Fotos und Scan, keine Messung" ; lrec:verificationStatus "offen: Bestätigung durch Flo nötig" ;
    lrec:proposesReferent ex:c_denkmal ; prov:wasAttributedTo ex:claude_sonnet_5_5 ; prov:wasGeneratedBy ex:ident_m1 .
ex:ev_m1_1 lrec:supports ex:hyp_m1_a .
ex:ev_m1_2 lrec:supports ex:hyp_m1_a .
