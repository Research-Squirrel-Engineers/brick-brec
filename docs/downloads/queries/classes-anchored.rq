PREFIX brec: <https://example.org/brick-reconstruction#>
PREFIX ex: <https://example.org/brick-reconstruction/id/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmdig: <http://www.cidoc-crm.org/extensions/crmdig/>
PREFIX crminf: <http://www.ics.forth.gr/isl/CRMinf/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?class ?anchor WHERE {
  ?class a owl:Class ; rdfs:subClassOf ?anchor .
  FILTER(STRSTARTS(STR(?class), "https://example.org/brick-reconstruction#"))
  FILTER(STRSTARTS(STR(?anchor), "http://www.cidoc-crm.org/") || STRSTARTS(STR(?anchor), "http://www.cidoc-crm.org/extensions/") || STRSTARTS(STR(?anchor), "http://www.ics.forth.gr/isl/CRMinf/"))
}
ORDER BY ?anchor ?class
