    rdfs:label "stepped pyramid with temple"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "step pyramid" .

ex:lego3_C2 a lrec:CandidateReferent ;
    rdfs:label "Mesoamerican pyramid"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "Mesoamerican pyramids" .

ex:lego3_C3 a lrec:CandidateReferent ;
    rdfs:label "El Castillo, Chichen Itza"@en ;
    rdfs:comment "candidate kind: individual"@en ;
    lrec:wikidataSearchTerm "El Castillo Chichen Itza" .

ex:lego3_C4 a lrec:CandidateReferent ;
    rdfs:label "Maya temple-pyramid"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "Maya pyramid" .

ex:lego3_C5 a lrec:CandidateReferent ;
    rdfs:label "pyramid temple"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "pyramid temple" .

ex:lego3_C7 a lrec:CandidateReferent ;
    rdfs:label "Pyramid of Djoser"@en ;
    rdfs:comment "candidate kind: individual"@en ;
    lrec:wikidataSearchTerm "Pyramid of Djoser" .

ex:lego3_E1 a lrec:Evidence ;
    rdfs:label "Four views from the sides show a symmetrical stepped taper with about eight receding levels."@en ;
    prov:wasDerivedFrom ex:lego3_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego3_H1,
        ex:lego3_H2,
        ex:lego3_H4,
        ex:lego3_H7 .

ex:lego3_E10 a lrec:Evidence ;
    rdfs:label "The black strips are one stud-row wide stacked bricks with a stepped profile, so the stairs are steep and brick-built rather than carved into every terrace."@en ;
    prov:wasDerivedFrom ex:lego3_views ;
    lrec:evidenceStrength "weak" .

ex:lego3_E2 a lrec:Evidence ;
    rdfs:label "The top view shows a black cross: one axial black stair strip on each of the four sides, meeting in the centre."@en ;
    prov:wasDerivedFrom ex:lego3_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego3_H1,
        ex:lego3_H2,
        ex:lego3_H3 ;
    lrec:weakens ex:lego3_H4,
        ex:lego3_H7 .

ex:lego3_E3 a lrec:Evidence ;
    rdfs:label "The surfaces carry round studs in a regular grid, and the model has 435 separate components, consistent with plastic building bricks."@en ;
    prov:wasDerivedFrom ex:lego3_views ;
    lrec:evidenceStrength "strong" .

ex:lego3_E4 a lrec:Evidence ;
    rdfs:label "A small dark block with light openings sits at the summit, reading as a shrine or temple."@en ;
    prov:wasDerivedFrom ex:lego3_views ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego3_H1,
        ex:lego3_H2,
        ex:lego3_H3,
        ex:lego3_H4,
        ex:lego3_H5 ;
    lrec:weakens ex:lego3_H6,
        ex:lego3_H7 .

ex:lego3_E5 a lrec:Evidence ;
    rdfs:label "Facts: footprint profile is a stepped taper (base ratio 0.966, top ratio 0.012), with 8 regularly spaced levels at a spacing of 0.09 of the height."@en ;
    prov:wasDerivedFrom ex:lego3_facts ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego3_H1,
        ex:lego3_H3 .

ex:lego3_E6 a lrec:Evidence ;
    rdfs:label "Facts: mirror symmetry about both horizontal axes is high, 4-fold rotation is medium, and mirror about up is low. The model is only roughly 4-fold symmetric."@en ;
    prov:wasDerivedFrom ex:lego3_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego3_H6 .

ex:lego3_E7 a lrec:Evidence ;
    rdfs:label "Colours are only near-black (59 %) and near-white (41 %), with grayscale-like appearance (mean saturation 0.03)."@en ;
    prov:wasDerivedFrom ex:lego3_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego3_H6 .

ex:lego3_E8 a lrec:Evidence ;
    rdfs:label "The staircase on each side is a single central strip, narrow relative to the terrace width, and the summit block is small relative to the base (top ratio 0.012 for the topmost extent)."@en ;
    prov:wasDerivedFrom ex:lego3_views ;
    lrec:evidenceStrength "moderate" ;
    lrec:weakens ex:lego3_H2,
        ex:lego3_H3,
        ex:lego3_H5 .

ex:lego3_E9 a lrec:Evidence ;
    rdfs:label "Extents are 0.0959 x 0.0959 x 0.0715, so height is about 75 % of the base width, which gives a fairly low pyramid."@en ;
    prov:wasDerivedFrom ex:lego3_facts ;
    lrec:evidenceStrength "weak" ;
    lrec:weakens ex:lego3_H1,
        ex:lego3_H3 .

ex:lego3_P1 a crm:E18_Physical_Thing ;
    rdfs:label "stepped terraces"@en ;
    dct:description "about eight receding square levels in white/light grey, each roughly 0.09 of the height apart; studs visible on the top faces"@en ;
    rdfs:comment "count: 1"@en .

ex:lego3_P2 a crm:E18_Physical_Thing ;
    rdfs:label "stair arms"@en ;
    dct:description "black strips running from the base to the top on all four sides, forming a cross in the top view; the black bricks step up in a staircase profile"@en ;
    rdfs:comment "count: 4"@en .

ex:lego3_P4 a crm:E18_Physical_Thing ;
    rdfs:label "base plate level"@en ;
    dct:description "lowest wide light level (about 97 % of the footprint) that carries the stair arms and has the largest flat area"@en ;
    rdfs:comment "count: 1"@en .

ex:lego3_levels a crm:E54_Dimension ;
    rdfs:label "Number of levels"@en ;
    crm:P90_has_value 8 .

ex:lego3_size a crm:E54_Dimension ;
    rdfs:label "Estimated real size (largest extent)"@en ;
    dct:description "unit m; bounding box 0.0959 x 0.0959 x 0.0715 in glTF metres; the base is about 12 studs wide with a stud pitch of about 5.5 % of the extent, i.e. about 8 mm, as in common brick systems"@en ;
    crm:P90_has_value 9.59e-02 ;
    lrec:confidence 0.5 .

ex:lego3_P3 a crm:E18_Physical_Thing ;
    rdfs:label "top structure"@en ;
    dct:description "small dark block at the summit with light openings or lighter bricks on its sides, reading as a roofed shrine or temple chamber"@en ;
    rdfs:comment "count: 1"@en .

ex:lego3_model a crmdig:D1_Digital_Object ;
    rdfs:label "3D model lego3"@en .

ex:lego3_H5 a lrec:IdentityHypothesis ;
    rdfs:label "Top structure as temple or shrine chamber with openings"@en ;
    rdfs:comment "feature check: openings or doorway -> partly (E4)"@en,
        "feature check: roof-like cap -> yes (E4)"@en ;
    prov:wasAttributedTo ex:lego3_interpreter ;
    prov:wasGeneratedBy ex:lego3_ident ;
    lrec:confidence 0.5 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:lego3_P3 ;
    lrec:proposesReferent ex:lego3_C5 ;
    lrec:specializes ex:lego3_H1 ;
    lrec:strongestCounterargument "The summit block is small and could merely be a decorative cap or a finishing brick stack."@en ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:lego3_H7 a lrec:IdentityHypothesis ;
    rdfs:label "Egyptian-style or other non-Mesoamerican step pyramid (e.g. Djoser, Khmer temple mountain)"@en ;
    rdfs:comment "feature check: four axial stairs -> no (E2)"@en,
        "feature check: six terraces -> no (E5)"@en ;
    prov:wasAttributedTo ex:lego3_interpreter ;
    prov:wasGeneratedBy ex:lego3_ident ;
    lrec:alternativeTo ex:lego3_H2 ;
    lrec:confidence 0.1 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:lego3_object ;
    lrec:proposesReferent ex:lego3_C7 ;
    lrec:specializes ex:lego3_H1 ;
    lrec:strongestCounterargument "Djoser has six steps and no stairs or summit temple, whereas the model has four axial stairs and a top structure."@en ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:lego3_facts a crmdig:D1_Digital_Object ;
    rdfs:label "Measured facts (JSON)"@en ;
    prov:wasDerivedFrom ex:lego3_model .

ex:lego3_H4 a lrec:IdentityHypothesis ;
    rdfs:label "Other Maya pyramids (e.g. Temple of the Inscriptions, Tikal temples) or Aztec Templo Mayor type"@en ;
    rdfs:comment "feature check: one dominant staircase -> no (E2)"@en ;
    prov:wasAttributedTo ex:lego3_interpreter ;
    prov:wasGeneratedBy ex:lego3_ident ;
    lrec:alternativeTo ex:lego3_H3 ;
    lrec:confidence 0.1 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:lego3_object ;
    lrec:proposesReferent ex:lego3_C4 ;
    lrec:specializes ex:lego3_H2 ;
    lrec:strongestCounterargument "These usually have a single front staircase, while the model has four of them."@en ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:lego3_H6 a lrec:IdentityHypothesis ;
    rdfs:label "Free design without a real-world model (generic brick pyramid)"@en ;
    rdfs:comment "feature check: approximately symmetric build without irregular details -> yes (E6)"@en,
        "feature check: simple strict black/white scheme -> yes (E7)"@en ;
    prov:wasAttributedTo ex:lego3_interpreter ;
    prov:wasGeneratedBy ex:lego3_ident ;
    lrec:alternativeTo ex:lego3_H1 ;
    lrec:confidence 0.3 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:lego3_object ;
    lrec:strongestCounterargument "The four-fold stairs and the summit shrine are specific features that make a deliberate reference to temple-pyramids likely."@en ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:lego3_views a crmdig:D1_Digital_Object ;
    rdfs:label "Standard views (contact sheet)"@en ;
