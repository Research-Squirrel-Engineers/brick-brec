ex:lego_object a crm:E18_Physical_Thing ;
    rdfs:label "Object shown by lego"@en ;
    dct:description "Rectangular stepped pyramid of light grey studded bricks on a flat base course, with a narrow one-stud square column on top carrying a small minifigure with a domed, knobbed grey helmet, tan torso and blue legs."@en ;
    dct:format "brick_built_toy" ;
    dct:medium "plastic building bricks (studs visible)"@en ;
    dct:type "scene_or_assembly" ;
    crm:P43_has_dimension ex:lego_levels,
        ex:lego_size ;
    crm:P46_is_composed_of ex:lego_P1,
        ex:lego_P2,
        ex:lego_P3,
        ex:lego_P4 ;
    rdfs:comment "Overall shape: stepped taper with rectangular footprint (about 0.096 x 0.075 m), a narrow square column and a small figure on top. Mirror axes: a, b; rotational fold: None."@en .

