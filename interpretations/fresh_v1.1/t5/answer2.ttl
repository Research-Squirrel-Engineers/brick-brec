ex:lego_H2 a lrec:IdentityHypothesis ;
    rdfs:label "Roman victory column with a helmeted soldier or emperor on top"@en ;
    rdfs:comment "feature check: door in the pedestal -> no (E6)"@en,
        "feature check: helmeted figure on top -> yes (E3)"@en,
