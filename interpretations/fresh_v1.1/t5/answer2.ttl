        ex:lego_E3,
        ex:lego_E4,
        ex:lego_E5,
        ex:lego_E6,
        ex:lego_E7,
        ex:lego_E8,
        ex:lego_E9 ;
    crminf:J2_concluded_that ex:lego_H1,
