        ex:lego_H4,
        ex:lego_H5,
        ex:lego_H6,
        ex:lego_H7,
        ex:lego_H8 ;
    prov:wasAssociatedWith ex:lego_interpreter ;
    lrec:interpretationJson "{\"schema\": \"lrec-model-interpretation/1.1\", \"model_id\": \"lego\", \"interpreter\": {\"name\": \"Claude\", \"model_id_self_reported\": \"claude-sonnet-5-5\", \"context\": \"second pass on contact sheet and facts only; no prior knowledge of the model\"}, \"object\": {\"short_description\": \"Rectangular stepped pyramid of light grey studded bricks on a flat base course, with a narrow one-stud square column on top carrying a small minifigure with a domed, knobbed grey helmet, tan torso and blue legs.\", \"category\": \"scene_or_assembly\", \"construction_technique\": \"brick_built_toy\", \"construction_material\": \"plastic building bricks (studs visible)\", \"estimated_real_size\": {\"value\": 0.123, \"unit\": \"m\", \"confidence\": 0.6, \"basis\": \"bounding box height 0.123 m in glTF metres; studs visible, so a toy-scale model\"}, \"up_axis\": {\"axis\": \"y\", \"sign\": \"+\", \"confidence\": 0.9}}, \"structure\": {\"overall_shape\": \"stepped taper with rectangular footprint (about 0.096 x 0.075 m), a narrow square column and a small figure on top\", \"levels\": 6, \"symmetry\": {\"mirror_axes\": [\"a\", \"b\"], \"rotational_fold\": null}, \"components\": [{\"id\": \"P1\", \"name\": \"stepped pyramid body\", \"description\": \"flat plate-like base course plus six receding rectangular levels of light grey bricks with exposed studs on each tread; the treads are one stud deep on the long sides; all four sides are stepped, none has a stair or ramp. In the views it occupies about half of the total height.\", \"count\": 1}, {\"id\": \"P2\", \"name\": \"column or pedestal\", \"description\": \"slender square shaft of light bricks, one stud wide, rising from the centre of the top step; roughly one fifth of the total height in the views.\", \"count\": 1}, {\"id\": \"P3\", \"name\": \"minifigure on top\", \"description\": \"small figure about a quarter of the total height: silver-grey domed helmet with a small knob, light torso with tan front and back panels, blue legs and brown feet; in the right and left views one arm is held out to the side or slightly forward, in the front and back views the arms hang at the sides.\", \"count\": 1}, {\"id\": \"P4\", \"name\": \"helmet\", \"description\": \"rounded silver-grey helmet with a small finial or knob on top; no visible plume, crest or horns; a nose guard cannot be confirmed at this resolution.\", \"count\": 1}], \"repeated_elements\": [{\"what\": \"round studs on the treads of the steps\", \"pitch_relative_to_largest_extent\": 0.0547, \"count\": null}]}, \"capture\": {\"likely_origin\": \"cad_or_procedural\", \"defects\": [\"mesh is not watertight (464 boundary edges)\", \"diagonal triangulation lines visible on flat brick faces\", \"380 separate connected components (individual bricks)\"], \"floor_or_background_included\": false}, \"evidence\": [{\"id\": \"E1\", \"statement\": \"Receding rectangular levels with exposed studs on the treads are visible in the front, right, back and left views; the 3/4 view shows all four sides stepped. I count a flat base course plus about six stepped levels; the exact count is uncertain by one because treads are thin at this resolution.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E2\", \"statement\": \"A slender one-stud square column rises from the centre of the top step and carries a single small figure; the figure is slightly taller than the column.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E3\", \"statement\": \"The figure wears a domed silver-grey helmet with a small knob, tan torso panels and blue legs with brown feet; one arm is stretched sideways in the right and left views, while in the front and back views the arms hang down.\", \"source\": \"views\", \"strength\": \"moderate\"}, {\"id\": \"E4\", \"statement\": \"Facts report a stepped_taper footprint profile, 6 regular steps, mirror symmetry about both horizontal axes (rated high) and 380 connected components, which fits a model built from separate bricks.\", \"source\": \"facts\", \"strength\": \"strong\"}, {\"id\": \"E5\", \"statement\": \"Studs are visible on the treads and a periodic pattern of about 5.5 % of the extent is detected; the dominant colour is light grey (98.9 %), so the body is monochrome and only the figure is coloured.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E6\", \"statement\": \"The footprint is rectangular, not square (0.0959 x 0.0746 m), so the long and short sides differ; no stair arms, ramps, openings or doors are visible on any side; the top view shows the column and figure centred.\", \"source\": \"views\", \"strength\": \"moderate\"}, {\"id\": \"E7\", \"statement\": \"Bounding box height is 0.123 m; the facts list flat upward-facing levels only up to height_rel 0.312, while the views show the stepped body taking roughly half of the height, so the detected levels capture only part of the steps and the figure and column are a smaller share than a first reading suggests.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E8\", \"statement\": \"No inscription, door, sign, relief, text or other attribute is visible that would identify a specific real building or person.\", \"source\": \"views\", \"strength\": \"weak\"}, {\"id\": \"E9\", \"statement\": \"The column is plain and undecorated, with no capital, relief spiral or inscription; the figure is a standard minifigure scale (very small relative to the base) and not statue-coloured.\", \"source\": \"views\", \"strength\": \"moderate\"}], \"hypotheses\": [{\"id\": \"H1\", \"label\": \"Brick-built monument: stepped plinth with a column and a statue-like figure on top\", \"confidence\": 0.5, \"supports\": [\"E1\", \"E2\", \"E4\"], \"weakens\": [\"E8\", \"E9\"], \"alternative_to\": [\"H3\"], \"specializes\": null, \"candidate\": {\"label\": \"commemorative column on stepped base\", \"kind\": \"type\", \"wikidata_search_term\": \"memorial column\"}, \"strongest_counterargument\": \"The figure is a normal coloured minifigure, not a statue-coloured one, so it may simply stand on a tower rather than represent a monument.\", \"about\": null, \"feature_checks\": [{\"feature\": \"stepped base\", \"observed\": \"yes\", \"evidence\": [\"E1\"]}, {\"feature\": \"single slender shaft on the base\", \"observed\": \"yes\", \"evidence\": [\"E2\"]}, {\"feature\": \"figure on top of the shaft\", \"observed\": \"yes\", \"evidence\": [\"E2\", \"E3\"]}, {\"feature\": \"inscription or relief on shaft\", \"observed\": \"no\", \"evidence\": [\"E8\", \"E9\"]}]}, {\"id\": \"H2\", \"label\": \"Roman victory column with a helmeted soldier or emperor on top\", \"confidence\": 0.15, \"supports\": [\"E2\", \"E3\"], \"weakens\": [\"E8\", \"E9\"], \"alternative_to\": [\"H5\"], \"specializes\": \"H1\", \"candidate\": {\"label\": \"Trajan's Column\", \"kind\": \"individual\", \"wikidata_search_term\": \"Trajan's Column\"}, \"strongest_counterargument\": \"Trajan's Column has a spiral relief frieze, a square pedestal with doors and a wider capital, and none of that is modelled; the base here is a many-step pyramid.\", \"about\": null, \"feature_checks\": [{\"feature\": \"helmeted figure on top\", \"observed\": \"yes\", \"evidence\": [\"E3\"]}, {\"feature\": \"pedestal with steps\", \"observed\": \"partly\", \"evidence\": [\"E1\"]}, {\"feature\": \"spiral relief frieze on shaft\", \"observed\": \"no\", \"evidence\": [\"E9\"]}, {\"feature\": \"door in the pedestal\", \"observed\": \"no\", \"evidence\": [\"E6\"]}]}, {\"id\": \"H3\", \"label\": \"Stepped pyramid or ziggurat-like structure with a figure at the apex\", \"confidence\": 0.35, \"supports\": [\"E1\", \"E4\", \"E7\"], \"weakens\": [\"E6\", \"E9\"], \"alternative_to\": [\"H1\"], \"specializes\": null, \"candidate\": {\"label\": \"step pyramid\", \"kind\": \"type\", \"wikidata_search_term\": \"step pyramid\"}, \"strongest_counterargument\": \"The steps have no stair arms and no temple on top, and a tall pillar plus a figure is not typical of a pyramid.\", \"about\": null, \"feature_checks\": [{\"feature\": \"about six receding levels\", \"observed\": \"yes\", \"evidence\": [\"E1\", \"E4\"]}, {\"feature\": \"stairs or ramp on one or more sides\", \"observed\": \"no\", \"evidence\": [\"E6\"]}, {\"feature\": \"temple or shrine at the top\", \"observed\": \"no\", \"evidence\": [\"E2\"]}]}, {\"id\": \"H4\", \"label\": \"Minifigure with a helmet and extended arm (a character, possibly a guard or soldier)\", \"confidence\": 0.5, \"supports\": [\"E3\"], \"weakens\": [\"E8\"], \"alternative_to\": [], \"specializes\": null, \"candidate\": {\"label\": \"toy minifigure\", \"kind\": \"type\", \"wikidata_search_term\": \"Lego minifigure\"}, \"strongest_counterargument\": \"The figure is very small in the views, so the helmet shape and the outstretched arm are only partly reliable.\", \"about\": \"P3\", \"feature_checks\": [{\"feature\": \"domed helmet with a small finial\", \"observed\": \"yes\", \"evidence\": [\"E3\"]}, {\"feature\": \"tan torso and blue legs\", \"observed\": \"yes\", \"evidence\": [\"E3\"]}, {\"feature\": \"one arm held away from the body\", \"observed\": \"partly\", \"evidence\": [\"E3\"]}]}, {\"id\": \"H5\", \"label\": \"Column monument of a stepped-base type with a national or military hero on top\", \"confidence\": 0.1, \"supports\": [\"E2\", \"E7\"], \"weakens\": [\"E6\", \"E8\", \"E9\"], \"alternative_to\": [\"H2\"], \"specializes\": \"H1\", \"candidate\": {\"label\": \"Nelson's Column\", \"kind\": \"individual\", \"wikidata_search_term\": \"Nelson's Column\"}, \"strongest_counterargument\": \"The helmet is a spiked or domed helmet and not an admiral's bicorn hat, and the base is a many-step pyramid, not a square plinth with lions.\", \"about\": null, \"feature_checks\": [{\"feature\": \"statue on very tall column\", \"observed\": \"partly\", \"evidence\": [\"E2\"]}, {\"feature\": \"lions at the base\", \"observed\": \"no\", \"evidence\": [\"E8\"]}, {\"featur