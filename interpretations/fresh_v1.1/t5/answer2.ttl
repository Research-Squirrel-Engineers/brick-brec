ex:lego_E1 a lrec:Evidence ;
    rdfs:label "Receding rectangular levels with exposed studs on the treads are visible in the front, right, back and left views; the 3/4 view shows all four sides stepped. I count a flat base course plus about six stepped levels; the exact count is uncertain by one because treads are thin at this resolution."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego_H1,
        ex:lego_H3,
        ex:lego_H8 .

ex:lego_E2 a lrec:Evidence ;
    rdfs:label "A slender one-stud square column rises from the centre of the top step and carries a single small figure; the figure is slightly taller than the column."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego_H1,
        ex:lego_H2,
        ex:lego_H5 ;
    lrec:weakens ex:lego_H8 .

ex:lego_E3 a lrec:Evidence ;
    rdfs:label "The figure wears a domed silver-grey helmet with a small knob, tan torso panels and blue legs with brown feet; one arm is stretched sideways in the right and left views, while in the front and back views the arms hang down."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H2,
        ex:lego_H4,
        ex:lego_H7 .

ex:lego_E4 a lrec:Evidence ;
    rdfs:label "Facts report a stepped_taper footprint profile, 6 regular steps, mirror symmetry about both horizontal axes (rated high) and 380 connected components, which fits a model built from separate bricks."@en ;
    prov:wasDerivedFrom ex:lego_facts ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego_H1,
        ex:lego_H3,
        ex:lego_H8 .

ex:lego_E5 a lrec:Evidence ;
    rdfs:label "Studs are visible on the treads and a periodic pattern of about 5.5 % of the extent is detected; the dominant colour is light grey (98.9 %), so the body is monochrome and only the figure is coloured."@en ;
    prov:wasDerivedFrom ex:lego_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H6 .

ex:lego_E6 a lrec:Evidence ;
    rdfs:label "The footprint is rectangular, not square (0.0959 x 0.0746 m), so the long and short sides differ; no stair arms, ramps, openings or doors are visible on any side; the top view shows the column and figure centred."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H6,
        ex:lego_H8 ;
    lrec:weakens ex:lego_H3,
        ex:lego_H5 .

ex:lego_E7 a lrec:Evidence ;
    rdfs:label "Bounding box height is 0.123 m; the facts list flat upward-facing levels only up to height_rel 0.312, while the views show the stepped body taking roughly half of the height, so the detected levels capture only part of the steps and the figure and column are a smaller share than a first reading suggests."@en ;
    prov:wasDerivedFrom ex:lego_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H3,
        ex:lego_H5 .

ex:lego_E8 a lrec:Evidence ;
    rdfs:label "No inscription, door, sign, relief, text or other attribute is visible that would identify a specific real building or person."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "weak" ;
    lrec:supports ex:lego_H6 ;
    lrec:weakens ex:lego_H1,
        ex:lego_H2,
        ex:lego_H4,
        ex:lego_H5,
        ex:lego_H7 .

ex:lego_E9 a lrec:Evidence ;
    rdfs:label "The column is plain and undecorated, with no capital, relief spiral or inscription; the figure is a standard minifigure scale (very small relative to the base) and not statue-coloured."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "moderate" ;
    lrec:weakens ex:lego_H1,
        ex:lego_H2,
        ex:lego_H3,
        ex:lego_H5,
        ex:lego_H8 .

ex:lego_P2 a crm:E18_Physical_Thing ;
    rdfs:label "column or pedestal"@en ;
    dct:description "slender square shaft of light bricks, one stud wide, rising from the centre of the top step; roughly one fifth of the total height in the views."@en ;
    rdfs:comment "count: 1"@en .

ex:lego_levels a crm:E54_Dimension ;
    rdfs:label "Number of levels"@en ;
    crm:P90_has_value 6 .

ex:lego_size a crm:E54_Dimension ;
    rdfs:label "Estimated real size (largest extent)"@en ;
    dct:description "unit m; bounding box height 0.123 m in glTF metres; studs visible, so a toy-scale model"@en ;
    crm:P90_has_value 1.23e-01 ;
    lrec:confidence 0.6 .

ex:lego_P1 a crm:E18_Physical_Thing ;
    rdfs:label "stepped pyramid body"@en ;
    dct:description "flat plate-like base course plus six receding rectangular levels of light grey bricks with exposed studs on each tread; the treads are one stud deep on the long sides; all four sides are stepped, none has a stair or ramp. In the views it occupies about half of the total height."@en ;
    rdfs:comment "count: 1"@en .

ex:lego_P3 a crm:E18_Physical_Thing ;
    rdfs:label "minifigure on top"@en ;
    dct:description "small figure about a quarter of the total height: silver-grey domed helmet with a small knob, light torso with tan front and back panels, blue legs and brown feet; in the right and left views one arm is held out to the side or slightly forward, in the front and back views the arms hang at the sides."@en ;
    rdfs:comment "count: 1"@en .

ex:lego_P4 a crm:E18_Physical_Thing ;
    rdfs:label "helmet"@en ;
    dct:description "rounded silver-grey helmet with a small finial or knob on top; no visible plume, crest or horns; a nose guard cannot be confirmed at this resolution."@en ;
    rdfs:comment "count: 1"@en .

ex:lego_model a crmdig:D1_Digital_Object ;
    rdfs:label "3D model lego"@en .

ex:lego_H7 a lrec:IdentityHypothesis ;
    rdfs:label "Helmet is an early medieval or Migration-period spiked or conical helmet of a warrior figure"@en ;
    rdfs:comment "feature check: nose guard -> unknown (E3)"@en,
        "feature check: plume or crest (Roman type) -> no (E3)"@en,
        "feature check: rounded or conical dome -> yes (E3)"@en,
        "feature check: small finial or knob on top -> yes (E3)"@en ;
    prov:wasAttributedTo ex:lego_interpreter ;
    prov:wasGeneratedBy ex:lego_ident ;
    lrec:confidence 0.3 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:lego_P4 ;
    lrec:proposesReferent ex:lego_C7 ;
    lrec:specializes ex:lego_H4 ;
    lrec:strongestCounterargument "The helmet is only a few pixels wide and a plain rounded minifigure helmet with a knob could equally be a Roman or generic soldier helmet, so no period can be fixed."@en ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:lego_facts a crmdig:D1_Digital_Object ;
    rdfs:label "Measured facts (JSON)"@en ;
    prov:wasDerivedFrom ex:lego_model .

ex:lego_H4 a lrec:IdentityHypothesis ;
    rdfs:label "Minifigure with a helmet and extended arm (a character, possibly a guard or soldier)"@en ;
    rdfs:comment "feature check: domed helmet with a small finial -> yes (E3)"@en,
        "feature check: one arm held away from the body -> partly (E3)"@en,
        "feature check: tan torso and blue legs -> yes (E3)"@en ;
    prov:wasAttributedTo ex:lego_interpreter ;
    prov:wasGeneratedBy ex:lego_ident ;
    lrec:confidence 0.5 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:lego_P3 ;
    lrec:proposesReferent ex:lego_C4 ;
    lrec:strongestCounterargument "The figure is very small in the views, so the helmet shape and the outstretched arm are only partly reliable."@en ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:lego_H6 a lrec:IdentityHypothesis ;
    rdfs:label "Free design without a real-world model (a generic display or demonstration build)"@en ;
    rdfs:comment "feature check: no distinctive identifying attributes -> yes (E8, E9)"@en ;
    prov:wasAttributedTo ex:lego_interpreter ;
