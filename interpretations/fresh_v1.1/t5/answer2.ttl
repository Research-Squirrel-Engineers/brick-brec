ex:lego_H8 a lrec:IdentityHypothesis ;
    rdfs:label "Stepped pyramid with a rectangular footprint and about six tiers modelled on an Egyptian step pyramid"@en ;
    rdfs:comment "feature check: flat apex without superstructure -> no (E2)"@en,
        "feature check: rectangular, not square, footprint -> yes (E6)"@en,
        "feature check: six tiers -> partly (E1, E4)"@en ;
    prov:wasAttributedTo ex:lego_interpreter ;
    prov:wasGeneratedBy ex:lego_ident ;
    lrec:alternativeTo ex:lego_H6 ;
    lrec:confidence 0.12 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:lego_P1 ;
    lrec:proposesReferent ex:lego_C8 ;
    lrec:specializes ex:lego_H3 ;
    lrec:strongestCounterargument "The Djoser pyramid has six tiers and a rectangular plan, but it carries no column or figure on top and its tiers are much taller and irregular, not one-stud treads."@en ;
