ex:lego_E1 a lrec:Evidence ;
    rdfs:label "Six receding rectangular levels with exposed studs on the treads are visible in the front, right, back and left views; the 3/4 view shows all four sides stepped."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego_H1,
        ex:lego_H3,
        ex:lego_H7 .

ex:lego_E2 a lrec:Evidence ;
    rdfs:label "A slender square column rises from the top step and carries a small figure; the figure is about as tall as the column."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego_H1,
        ex:lego_H2,
        ex:lego_H5 ;
    lrec:weakens ex:lego_H7 .

ex:lego_E3 a lrec:Evidence ;
    rdfs:label "The figure wears a domed silver-grey helmet with a small spike or knob, a tan torso and blue legs with brown feet; one arm is stretched sideways in the right and left views."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H2,
        ex:lego_H4 .

ex:lego_E4 a lrec:Evidence ;
    rdfs:label "Facts report a stepped_taper footprint profile, 6 regular steps, mirror symmetry about both horizontal axes (rated high) and 380 connected components, which fits a model built from separate bricks."@en ;
    prov:wasDerivedFrom ex:lego_facts ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:lego_H1,
        ex:lego_H3 .

ex:lego_E5 a lrec:Evidence ;
    rdfs:label "Studs are visible on the treads and a periodic pattern of about 5.5 % of the extent is detected; the dominant colour is light grey (98.9 %)."@en ;
    prov:wasDerivedFrom ex:lego_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H6,
        ex:lego_H7 .

ex:lego_E6 a lrec:Evidence ;
    rdfs:label "The footprint is rectangular, not square (0.0959 x 0.0746 m), and the four sides are not identical; no stair arms or openings are visible."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H6 ;
    lrec:weakens ex:lego_H3,
        ex:lego_H5 .

ex:lego_E7 a lrec:Evidence ;
    rdfs:label "Bounding box height is 0.123 m; the pyramid body takes about 0.31 of the height, the column and figure the rest (surface levels at height_rel up to 0.312)."@en ;
    prov:wasDerivedFrom ex:lego_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:lego_H3,
        ex:lego_H5 .

ex:lego_E8 a lrec:Evidence ;
    rdfs:label "No inscription, door, sign or other attribute is visible that would identify a specific real building or person."@en ;
    prov:wasDerivedFrom ex:lego_views ;
    lrec:evidenceStrength "weak" ;
    lrec:supports ex:lego_H6 ;
    lrec:weakens ex:lego_H1,
        ex:lego_H2,
        ex:lego_H4 .

