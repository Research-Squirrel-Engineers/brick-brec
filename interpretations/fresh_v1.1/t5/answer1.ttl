@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lrec:evidenceStrength a owl:DatatypeProperty ;
    rdfs:domain lrec:Evidence ;
    rdfs:range xsd:string .

lrec:interpretationJson a owl:DatatypeProperty ;
    rdfs:domain lrec:Identification ;
    rdfs:range rdf:JSON .

lrec:strongestCounterargument a owl:DatatypeProperty ;
    rdfs:domain lrec:IdentityHypothesis ;
    rdfs:range xsd:string .

