@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/lego-reconstruction/id/> .
@prefix lrec: <https://example.org/lego-reconstruction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lrec:evidenceStrength a owl:DatatypeProperty ;
    rdfs:domain lrec:Evidence ;
    rdfs:range xsd:string .

lrec:interpretationJson a owl:DatatypeProperty ;
    rdfs:domain lrec:Identification ;
    rdfs:range rdf:JSON .

ex:3DModel_C1 a lrec:CandidateReferent ;
    rdfs:label "step pyramid"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "step pyramid" .

ex:3DModel_C2 a lrec:CandidateReferent ;
    rdfs:label "Mesoamerican pyramid"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "Mesoamerican pyramid" .

ex:3DModel_C3 a lrec:CandidateReferent ;
    rdfs:label "terraced hill"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "terrace landform" .

ex:3DModel_E1 a lrec:Evidence ;
    rdfs:label "Side views show a tapering stepped body with several receding terraces and a smaller structure at the apex."@en ;
    prov:wasDerivedFrom ex:3DModel_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:3DModel_H1,
        ex:3DModel_H2,
        ex:3DModel_H4 .

ex:3DModel_E2 a lrec:Evidence ;
    rdfs:label "The top view shows concentric, roughly square terrace outlines around a small central block."@en ;
    prov:wasDerivedFrom ex:3DModel_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:3DModel_H1,
        ex:3DModel_H2 ;
    lrec:weakens ex:3DModel_H3 .

ex:3DModel_E3 a lrec:Evidence ;
    rdfs:label "A rectangular ground patch with undulating, curling edges surrounds the pyramid, so terrain is included in the model."@en ;
    prov:wasDerivedFrom ex:3DModel_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:3DModel_H1,
        ex:3DModel_H3 .

ex:3DModel_E4 a lrec:Evidence ;
    rdfs:label "The mesh is a single component and is not watertight (508 boundary edges), with irregular triangulation and a 4096x4096 texture. This is typical of a reconstructed surface."@en ;
    prov:wasDerivedFrom ex:3DModel_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:3DModel_H1 ;
    lrec:weakens ex:3DModel_H4 .

ex:3DModel_E5 a lrec:Evidence ;
    rdfs:label "Symmetry scores are low on all axes, and no periodic pattern is detected; the form is irregular rather than ideally regular."@en ;
    prov:wasDerivedFrom ex:3DModel_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:3DModel_H3 ;
    lrec:weakens ex:3DModel_H1 .

ex:3DModel_E6 a lrec:Evidence ;
    rdfs:label "The up-axis heuristic has low confidence (0.25), but the views show the pyramid standing upright with the summit pointing up in the analysis frame (up = y in file coordinates)."@en ;
    prov:wasDerivedFrom ex:3DModel_facts ;
    lrec:evidenceStrength "moderate" .

ex:3DModel_E7 a lrec:Evidence ;
    rdfs:label "The colour is uniformly grey (saturation 0), so there are no colour cues about material or origin."@en ;
    prov:wasDerivedFrom ex:3DModel_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:3DModel_H4 ;
    lrec:weakens ex:3DModel_H2 .

ex:3DModel_E8 a lrec:Evidence ;
    rdfs:label "The summit structure is dark and irregular and the terrace edges are partly blocky and eroded-looking, which could indicate ruined or weathered masonry, or could be a reconstruction artefact."@en ;
    prov:wasDerivedFrom ex:3DModel_views ;
    lrec:evidenceStrength "weak" ;
    lrec:supports ex:3DModel_H2 .

ex:3DModel_E9 a lrec:Evidence ;
    rdfs:label "No scale reference exists in the views or facts; the unit of the coordinates is unknown."@en ;
    prov:wasDerivedFrom ex:3DModel_facts ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:3DModel_H5 ;
    lrec:weakens ex:3DModel_H2 .

ex:3DModel_P1 a crm:E18_Physical_Thing ;
    rdfs:label "stepped pyramid body"@en ;
    dct:description "Tapering body with several receding terraces visible on the stepped side faces and as concentric outlines in the top view; the pyramid appears slightly rotated relative to the ground patch edges."@en ;
    rdfs:comment "count: 1"@en .

ex:3DModel_P2 a crm:E18_Physical_Thing ;
    rdfs:label "summit structure"@en ;
    dct:description "Dark, irregular block-like mass on top, narrower than the top terrace; it may be a small temple or a shrine, or partly eroded or reconstructed masonry."@en ;
    rdfs:comment "count: 1"@en .

ex:3DModel_P3 a crm:E18_Physical_Thing ;
    rdfs:label "ground patch"@en ;
    dct:description "Irregular, undulating surface with dense triangulation surrounding the pyramid and forming a rectangular tile, with curling edges."@en ;
    rdfs:comment "count: 1"@en .

ex:3DModel_P4 a crm:E18_Physical_Thing ;
    rdfs:label "side stair or ramp strip"@en ;
    dct:description "Darker vertical strip or notch running up at least one face (front and back views), possibly a staircase or an erosion channel."@en .

ex:3DModel_H5 a lrec:IdentityHypothesis ;
    rdfs:label "Unknown"@en ;
    prov:wasAttributedTo ex:3DModel_interpreter ;
    prov:wasGeneratedBy ex:3DModel_ident ;
    lrec:confidence 0.1 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:3DModel_object ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:3DModel_model a crmdig:D1_Digital_Object ;
    rdfs:label "3D model 3DModel"@en .

ex:3DModel_H4 a lrec:IdentityHypothesis ;
    rdfs:label "Free design or a scaled physical or digital model of a pyramid without a specific real-world counterpart"@en ;
    prov:wasAttributedTo ex:3DModel_interpreter ;
    prov:wasGeneratedBy ex:3DModel_ident ;
    lrec:alternativeTo ex:3DModel_H1 ;
    lrec:confidence 0.15 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:3DModel_object ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:3DModel_views a crmdig:D1_Digital_Object ;
    rdfs:label "Standard views (contact sheet)"@en ;
    prov:wasDerivedFrom ex:3DModel_model .

ex:3DModel_facts a crmdig:D1_Digital_Object ;
    rdfs:label "Measured facts (JSON)"@en ;
    prov:wasDerivedFrom ex:3DModel_model .

ex:3DModel_ident a lrec:Identification ;
    rdfs:label "Identification of 3DModel"@en ;
    crm:P41_classified ex:3DModel_object ;
    crminf:J1_used_as_premise ex:3DModel_E1,
        ex:3DModel_E2,
        ex:3DModel_E3,
        ex:3DModel_E4,
        ex:3DModel_E5,
        ex:3DModel_E6,
        ex:3DModel_E7,
        ex:3DModel_E8,
        ex:3DModel_E9 ;
    crminf:J2_concluded_that ex:3DModel_H1,
        ex:3DModel_H2,
        ex:3DModel_H3,
        ex:3DModel_H4,
        ex:3DModel_H5 ;
    prov:wasAssociatedWith ex:3DModel_interpreter ;
    lrec:interpretationJson "{\"schema\": \"lrec-model-interpretation/1.0\", \"model_id\": \"3DModel\", \"interpreter\": {\"name\": \"Claude\", \"model_id_self_reported\": \"claude-sonnet-5-5\", \"context\": \"fresh session, no prior knowledge\"}, \"object\": {\"short_description\": \"Stepped, roughly square pyramid with a small block-like structure on its summit, standing on an irregular undulating ground patch; single grey textured mesh with a noisy, scan-like surface.\", \"category\": \"building_or_monument\", \"construction_technique\": \"unknown\", \"construction_material\": null, \"estimated_real_size\": {\"value\": null, \"unit\": null, \"confidence\": 0.0, \"basis\": \"File units are unknown (largest extent 0.6524, metres or arbitrary); no scale reference visible.\"}, \"up_axis\": {\"axis\": \"y\", \"sign\": \"+\", \"confidence\": 0.7}}, \"structure\": {\"overall_shape\": \"stepped square-based pyramid with a summit structure, embedded in a rectangular ground patch\", \"levels\": null, \"symmetry\": {\"mirror_axes\": [], \"rotational_fold\": null}, \"components\": [{\"id\": \"P1\", \"name\": \"stepped pyramid body\", \"description\": \"Tapering body with several receding terraces visible on the stepped side faces and as concentric outlines in the top view; the pyramid appears slightly rotated relative to the ground patch edges.\", \"count\": 1}, {\"id\": \"P2\", \"name\": \"summit structure\", \"description\": \"Dark, irregular block-like mass on top, narrower than the top terrace; it may be a small temple or a shrine, or partly eroded or reconstructed masonry.\", \"count\": 1}, {\"id\": \"P3\", \"name\": \"ground patch\", \"description\": \"Irregular, undulating surface with dense triangulation surrounding the pyramid and forming a rectangular tile, with curling edges.\", \"count\": 1}, {\"id\": \"P4\", \"name\": \"side stair or ramp strip\", \"description\": \"Darker vertical strip or notch running up at least one face (front and back views), possibly a staircase or an erosion channel.\", \"count\": null}], \"repeated_elements\": [{\"what\": \"terrace steps with a fine block-like relief pattern on the treads\", \"pitch_relative_to_largest_extent\": null, \"count\": null}]}, \"capture\": {\"likely_origin\": \"photogrammetry\", \"defects\": [\"non-watertight mesh with 508 boundary edges\", \"irregular, noisy triangulation\", \"ground patch with warped, curling edges\", \"dark, blobby summit geometry, possibly occlusion or reconstruction artefacts\", \"single grey colour reading (texture is almost uniform grey)\"], \"floor_or_background_included\": true}, \"evidence\": [{\"id\": \"E1\", \"statement\": \"Side views show a tapering stepped body with several receding terraces and a smaller structure at the apex.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E2\", \"statement\": \"The top view shows concentric, roughly square terrace outlines around a small central block.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E3\", \"statement\": \"A rectangular ground patch with undulating, curling edges surrounds the pyramid, so terrain is included in the model.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E4\", \"statement\": \"The mesh is a single component and is not watertight (508 boundary edges), with irregular triangulation and a 4096x4096 texture. This is typical of a reconstructed surface.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E5\", \"statement\": \"Symmetry scores are low on all axes, and no periodic pattern is detected; the form is irregular rather than ideally regular.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E6\", \"statement\": \"The up-axis heuristic has low confidence (0.25), but the views show the pyramid standing upright with the summit pointing up in the analysis frame (up = y in file coordinates).\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E7\", \"statement\": \"The colour is uniformly grey (saturation 0), so there are no colour cues about material or origin.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E8\", \"statement\": \"The summit structure is dark and irregular and the terrace edges are partly blocky and eroded-looking, which could indicate ruined or weathered masonry, or could be a reconstruction artefact.\", \"source\": \"views\", \"strength\": \"weak\"}, {\"id\": \"E9\", \"statement\": \"No scale reference exists in the views or facts; the unit of the coordinates is unknown.\", \"source\": \"facts\", \"strength\": \"strong\"}], \"hypotheses\": [{\"id\": \"H1\", \"label\": \"Scan of a stepped pyramid-type monument (e.g. a temple pyramid or earthwork) with a summit structure, including surrounding terrain\", \"confidence\": 0.6, \"supports\": [\"E1\", \"E2\", \"E3\", \"E4\"], \"weakens\": [\"E5\"], \"alternative_to\": [\"H3\"], \"specializes\": null, \"candidate\": {\"label\": \"step pyramid\", \"kind\": \"type\", \"wikidata_search_term\": \"step pyramid\"}}, {\"id\": \"H2\", \"label\": \"Mesoamerican-style temple pyramid with a temple on top, reconstructed from survey or photogrammetry\", \"confidence\": 0.25, \"supports\": [\"E1\", \"E2\", \"E8\"], \"weakens\": [\"E7\", \"E9\"], \"alternative_to\": [\"H3\"], \"specializes\": \"H1\", \"candidate\": {\"label\": \"Mesoamerican pyramid\", \"kind\": \"type\", \"wikidata_search_term\": \"Mesoamerican pyramid\"}}, {\"id\": \"H3\", \"label\": \"Terrain or digital elevation model of a hill with terraced slopes, not a built monument\", \"confidence\": 0.12, \"supports\": [\"E3\", \"E5\"], \"weakens\": [\"E2\"], \"alternative_to\": [\"H1\"], \"specializes\": null, \"candidate\": {\"label\": \"terraced hill\", \"kind\": \"type\", \"wikidata_search_term\": \"terrace landform\"}}, {\"id\": \"H4\", \"label\": \"Free design or a scaled physical or digital model of a pyramid without a specific real-world counterpart\", \"confidence\": 0.15, \"supports\": [\"E1\", \"E7\"], \"weakens\": [\"E4\"], \"alternative_to\": [\"H1\"], \"specializes\": null, \"candidate\": {\"label\": null, \"kind\": \"none\", \"wikidata_search_term\": null}}, {\"id\": \"H5\", \"label\": \"Unknown\", \"confidence\": 0.1, \"supports\": [\"E9\"], \"weakens\": [], \"alternative_to\": [], \"specializes\": null, \"candidate\": {\"label\": null, \"kind\": \"none\", \"wikidata_search_term\": null}}], \"questions_for_owner\": [\"Is this a real monument or site, and if so which one and where?\", \"How was the model captured (photogrammetry, drone survey, laser scan, modelling), and what was the capture scale?\", \"What are the units and real-world size of the model coordinates?\", \"Is the dark structure on top original, reconstructed or an artefact?\", \"Is the ground patch part of the intended object, or may it be removed?\"], \"notes\": \"Interpretation is based on six grey-shaded views and mesh statistics only. The specific identity of the monument cannot be determined from the evidence.\"}"^^rdf:JSON .

ex:3DModel_H2 a lrec:IdentityHypothesis ;
    rdfs:label "Mesoamerican-style temple pyramid with a temple on top, reconstructed from survey or photogrammetry"@en ;
    prov:wasAttributedTo ex:3DModel_interpreter ;
    prov:wasGeneratedBy ex:3DModel_ident ;
    lrec:alternativeTo ex:3DModel_H3 ;
    lrec:confidence 0.25 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:3DModel_object ;
    lrec:proposesReferent ex:3DModel_C2 ;
    lrec:specializes ex:3DModel_H1 ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:3DModel_H3 a lrec:IdentityHypothesis ;
    rdfs:label "Terrain or digital elevation model of a hill with terraced slopes, not a built monument"@en ;
    prov:wasAttributedTo ex:3DModel_interpreter ;
    prov:wasGeneratedBy ex:3DModel_ident ;
    lrec:alternativeTo ex:3DModel_H1 ;
    lrec:confidence 0.12 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:3DModel_object ;
    lrec:proposesReferent ex:3DModel_C3 ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:3DModel_interpreter a lrec:AIAssistant ;
    rdfs:label "Claude"@en ;
    dct:identifier "claude-sonnet-5-5" ;
    rdfs:comment "Self-reported model identifier; may differ from the serving model. Context: fresh session, no prior knowledge"@en .

ex:3DModel_object a crm:E18_Physical_Thing ;
    rdfs:label "Object shown by 3DModel"@en ;
    dct:description "Stepped, roughly square pyramid with a small block-like structure on its summit, standing on an irregular undulating ground patch; single grey textured mesh with a noisy, scan-like surface."@en ;
    dct:format "unknown" ;
    dct:type "building_or_monument" ;
    crm:P46_is_composed_of ex:3DModel_P1,
        ex:3DModel_P2,
        ex:3DModel_P3,
        ex:3DModel_P4 ;
    rdfs:comment "Overall shape: stepped square-based pyramid with a summit structure, embedded in a rectangular ground patch. Mirror axes: none; rotational fold: None."@en .

ex:3DModel_H1 a lrec:IdentityHypothesis ;
    rdfs:label "Scan of a stepped pyramid-type monument (e.g. a temple pyramid or earthwork) with a summit structure, including surrounding terrain"@en ;
    prov:wasAttributedTo ex:3DModel_interpreter ;
    prov:wasGeneratedBy ex:3DModel_ident ;
    lrec:alternativeTo ex:3DModel_H3 ;
    lrec:confidence 0.6 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:3DModel_object ;
    lrec:proposesReferent ex:3DModel_C1 ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

