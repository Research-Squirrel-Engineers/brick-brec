@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/lego-reconstruction/id/> .
@prefix lrec: <https://example.org/lego-reconstruction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lrec:evidenceStrength a owl:DatatypeProperty ;
    rdfs:domain lrec:Evidence ;
    rdfs:range xsd:string .

lrec:interpretationJson a owl:DatatypeProperty ;
    rdfs:domain lrec:Identification ;
    rdfs:range rdf:JSON .

ex:modelB_C1 a lrec:CandidateReferent ;
    rdfs:label "brick-built step pyramid"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "stepped pyramid" .

ex:modelB_C2 a lrec:CandidateReferent ;
    rdfs:label "commemorative column with statue on stepped plinth"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "memorial column" .

ex:modelB_C5 a lrec:CandidateReferent ;
    rdfs:label "display stand for minifigure"@en ;
    rdfs:comment "candidate kind: type"@en ;
    lrec:wikidataSearchTerm "minifigure" .

ex:modelB_E1 a lrec:Evidence ;
    rdfs:label "All four side views show a symmetric stepped taper with about seven receding levels, each with studs on the exposed ledges."@en ;
    prov:wasDerivedFrom ex:modelB_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:modelB_H1,
        ex:modelB_H2 ;
    lrec:weakens ex:modelB_H5 .

ex:modelB_E2 a lrec:Evidence ;
    rdfs:label "The top view shows a regular grid of round studs on a rectangular footprint, with the figure at the centre."@en ;
    prov:wasDerivedFrom ex:modelB_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:modelB_H1 .

ex:modelB_E3 a lrec:Evidence ;
    rdfs:label "A narrow column rises from the centre of the top step and carries a small humanoid figure with a helmet and a tan tunic."@en ;
    prov:wasDerivedFrom ex:modelB_views ;
    lrec:evidenceStrength "strong" ;
    lrec:supports ex:modelB_H1,
        ex:modelB_H2,
        ex:modelB_H3,
        ex:modelB_H5 .

ex:modelB_E4 a lrec:Evidence ;
    rdfs:label "Facts report 380 connected components, 22 geometries, 0 degenerate faces and a non-watertight mesh, consistent with an assembly of separate bricks."@en ;
    prov:wasDerivedFrom ex:modelB_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:modelB_H1,
        ex:modelB_H4 .

ex:modelB_E5 a lrec:Evidence ;
    rdfs:label "Facts report footprint type 'stepped_taper' with 7 plateaus and a periodic stud pattern with pitch about 5.5 % of extent a."@en ;
    prov:wasDerivedFrom ex:modelB_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:supports ex:modelB_H1,
        ex:modelB_H4 .

ex:modelB_E6 a lrec:Evidence ;
    rdfs:label "98.9 % of the surface is near-white or light grey (#edede9). The few colours (tan, blue, brown) belong to the figure."@en ;
    prov:wasDerivedFrom ex:modelB_facts ;
    lrec:evidenceStrength "moderate" ;
    lrec:weakens ex:modelB_H2 .

ex:modelB_E7 a lrec:Evidence ;
    rdfs:label "Mirror symmetry about both horizontal axes is rated high; mirror symmetry about the vertical axis is low, as expected for a tapering shape."@en ;
    prov:wasDerivedFrom ex:modelB_facts ;
    lrec:evidenceStrength "moderate" .

ex:modelB_E8 a lrec:Evidence ;
    rdfs:label "The figure is small compared with the pyramid, about 10 % of the total height, and its scale matches a minifigure on studs of about the same width as its body."@en ;
    prov:wasDerivedFrom ex:modelB_views ;
    lrec:evidenceStrength "weak" ;
    lrec:supports ex:modelB_H5 ;
    lrec:weakens ex:modelB_H3 .

ex:modelB_P1 a crm:E18_Physical_Thing ;
    rdfs:label "stepped pyramid body"@en ;
    dct:description "Rectangular footprint (about 0.096 x 0.075 in file units) with about seven receding levels. Light flat tiles or plates form the ledges and grey studded bricks fill in between."@en ;
    rdfs:comment "count: 1"@en .

ex:modelB_P2 a crm:E18_Physical_Thing ;
    rdfs:label "central column"@en ;
    dct:description "Narrow, roughly one-stud-wide light shaft rising from the top step to the figure; it appears to be about as tall as the upper half of the pyramid."@en ;
    rdfs:comment "count: 1"@en .

ex:modelB_P3 a crm:E18_Physical_Thing ;
    rdfs:label "figure on top"@en ;
    dct:description "Small minifigure-like character with a grey helmet that has a small knob or spike on top. It wears a tan or brown upper garment with blue and white details and dark brown lower parts. One arm is visible, extended to the side in the right and left views."@en ;
    rdfs:comment "count: 1"@en .

ex:modelB_P4 a crm:E18_Physical_Thing ;
    rdfs:label "base plate row"@en ;
    dct:description "Flat light base course around the lowest level, made of tiles or plates with visible seams."@en ;
    rdfs:comment "count: 1"@en .

ex:modelB_levels a crm:E54_Dimension ;
    rdfs:label "Number of levels"@en ;
    crm:P90_has_value 7 .

ex:modelB_size a crm:E54_Dimension ;
    rdfs:label "Estimated real size (largest extent)"@en ;
    dct:description "unit m; Footprint about 0.096 m wide in file units; the detected stud pitch is about 5.5 % of that width (about 5.2 mm). If the studs are a standard 8 mm brick pitch, the base would be about 0.146 m wide and the whole model about 0.19 m tall. The model may be scaled in the file, so this is an estimate."@en ;
    crm:P90_has_value 1.5e-01 ;
    lrec:confidence 0.25 .

ex:modelB_model a crmdig:D1_Digital_Object ;
    rdfs:label "3D model modelB"@en .

ex:modelB_H3 a lrec:IdentityHypothesis ;
    rdfs:label "Model of a specific real monument, for example a victory or memorial column"@en ;
    prov:wasAttributedTo ex:modelB_interpreter ;
    prov:wasGeneratedBy ex:modelB_ident ;
    lrec:alternativeTo ex:modelB_H4 ;
    lrec:confidence 0.1 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:modelB_object ;
    lrec:specializes ex:modelB_H2 ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:modelB_H4 a lrec:IdentityHypothesis ;
    rdfs:label "Free design without a specific real-world model"@en ;
    prov:wasAttributedTo ex:modelB_interpreter ;
    prov:wasGeneratedBy ex:modelB_ident ;
    lrec:alternativeTo ex:modelB_H3 ;
    lrec:confidence 0.4 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:modelB_object ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:modelB_H5 a lrec:IdentityHypothesis ;
    rdfs:label "Minifigure display stand or podium, with the stepped pyramid only as a pedestal"@en ;
    prov:wasAttributedTo ex:modelB_interpreter ;
    prov:wasGeneratedBy ex:modelB_ident ;
    lrec:alternativeTo ex:modelB_H2 ;
    lrec:confidence 0.2 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:modelB_object ;
    lrec:proposesReferent ex:modelB_C5 ;
    lrec:specializes ex:modelB_H1 ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:modelB_facts a crmdig:D1_Digital_Object ;
    rdfs:label "Measured facts (JSON)"@en ;
    prov:wasDerivedFrom ex:modelB_model .

ex:modelB_views a crmdig:D1_Digital_Object ;
    rdfs:label "Standard views (contact sheet)"@en ;
    prov:wasDerivedFrom ex:modelB_model .

ex:modelB_ident a lrec:Identification ;
    rdfs:label "Identification of modelB"@en ;
    crm:P41_classified ex:modelB_object ;
    crminf:J1_used_as_premise ex:modelB_E1,
        ex:modelB_E2,
        ex:modelB_E3,
        ex:modelB_E4,
        ex:modelB_E5,
        ex:modelB_E6,
        ex:modelB_E7,
        ex:modelB_E8 ;
    crminf:J2_concluded_that ex:modelB_H1,
        ex:modelB_H2,
        ex:modelB_H3,
        ex:modelB_H4,
        ex:modelB_H5 ;
    prov:wasAssociatedWith ex:modelB_interpreter ;
    lrec:interpretationJson "{\"schema\": \"lrec-model-interpretation/1.0\", \"model_id\": \"modelB\", \"interpreter\": {\"name\": \"Claude\", \"model_id_self_reported\": \"claude-sonnet-5-5\", \"context\": \"fresh session, no prior knowledge; analysis from contact sheet and facts only\"}, \"object\": {\"short_description\": \"Rectangular stepped pyramid built from light grey studded bricks, with a narrow one-stud-wide column rising from the centre and a small minifigure-like figure with a grey helmet and tan tunic standing on top.\", \"category\": \"scene_or_assembly\", \"construction_technique\": \"brick_built_toy\", \"construction_material\": \"plastic building bricks (appearance only; material not verifiable)\", \"estimated_real_size\": {\"value\": 0.15, \"unit\": \"m\", \"confidence\": 0.25, \"basis\": \"Footprint about 0.096 m wide in file units; the detected stud pitch is about 5.5 % of that width (about 5.2 mm). If the studs are a standard 8 mm brick pitch, the base would be about 0.146 m wide and the whole model about 0.19 m tall. The model may be scaled in the file, so this is an estimate.\"}, \"up_axis\": {\"axis\": \"y\", \"sign\": \"+\", \"confidence\": 0.9}}, \"structure\": {\"overall_shape\": \"stepped taper (rectangular stepped pyramid) with a slender central column and a small figure on the very top\", \"levels\": 7, \"symmetry\": {\"mirror_axes\": [\"a\", \"b\"], \"rotational_fold\": 2}, \"components\": [{\"id\": \"P1\", \"name\": \"stepped pyramid body\", \"description\": \"Rectangular footprint (about 0.096 x 0.075 in file units) with about seven receding levels. Light flat tiles or plates form the ledges and grey studded bricks fill in between.\", \"count\": 1}, {\"id\": \"P2\", \"name\": \"central column\", \"description\": \"Narrow, roughly one-stud-wide light shaft rising from the top step to the figure; it appears to be about as tall as the upper half of the pyramid.\", \"count\": 1}, {\"id\": \"P3\", \"name\": \"figure on top\", \"description\": \"Small minifigure-like character with a grey helmet that has a small knob or spike on top. It wears a tan or brown upper garment with blue and white details and dark brown lower parts. One arm is visible, extended to the side in the right and left views.\", \"count\": 1}, {\"id\": \"P4\", \"name\": \"base plate row\", \"description\": \"Flat light base course around the lowest level, made of tiles or plates with visible seams.\", \"count\": 1}], \"repeated_elements\": [{\"what\": \"round studs on the exposed step surfaces and the top view\", \"pitch_relative_to_largest_extent\": 0.0547, \"count\": null}]}, \"capture\": {\"likely_origin\": \"cad_or_procedural\", \"defects\": [\"not watertight: 464 boundary edges\", \"380 connected components, consistent with separate bricks\", \"thin diagonal triangulation lines on flat faces are visible, probably a rendering or tessellation artefact\", \"figure is textured while the bricks are almost uniformly light grey\"], \"floor_or_background_included\": false}, \"evidence\": [{\"id\": \"E1\", \"statement\": \"All four side views show a symmetric stepped taper with about seven receding levels, each with studs on the exposed ledges.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E2\", \"statement\": \"The top view shows a regular grid of round studs on a rectangular footprint, with the figure at the centre.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E3\", \"statement\": \"A narrow column rises from the centre of the top step and carries a small humanoid figure with a helmet and a tan tunic.\", \"source\": \"views\", \"strength\": \"strong\"}, {\"id\": \"E4\", \"statement\": \"Facts report 380 connected components, 22 geometries, 0 degenerate faces and a non-watertight mesh, consistent with an assembly of separate bricks.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E5\", \"statement\": \"Facts report footprint type 'stepped_taper' with 7 plateaus and a periodic stud pattern with pitch about 5.5 % of extent a.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E6\", \"statement\": \"98.9 % of the surface is near-white or light grey (#edede9). The few colours (tan, blue, brown) belong to the figure.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E7\", \"statement\": \"Mirror symmetry about both horizontal axes is rated high; mirror symmetry about the vertical axis is low, as expected for a tapering shape.\", \"source\": \"facts\", \"strength\": \"moderate\"}, {\"id\": \"E8\", \"statement\": \"The figure is small compared with the pyramid, about 10 % of the total height, and its scale matches a minifigure on studs of about the same width as its body.\", \"source\": \"views\", \"strength\": \"weak\"}], \"hypotheses\": [{\"id\": \"H1\", \"label\": \"Brick-built stepped pyramid with a central pillar and a figure on top, a toy or display model\", \"confidence\": 0.7, \"supports\": [\"E1\", \"E2\", \"E3\", \"E4\", \"E5\"], \"weakens\": [], \"alternative_to\": [], \"specializes\": null, \"candidate\": {\"label\": \"brick-built step pyramid\", \"kind\": \"type\", \"wikidata_search_term\": \"stepped pyramid\"}}, {\"id\": \"H2\", \"label\": \"Monument or column on a stepped base with a statue of a warrior or soldier on top\", \"confidence\": 0.3, \"supports\": [\"E3\", \"E1\"], \"weakens\": [\"E6\"], \"alternative_to\": [], \"specializes\": \"H1\", \"candidate\": {\"label\": \"commemorative column with statue on stepped plinth\", \"kind\": \"type\", \"wikidata_search_term\": \"memorial column\"}}, {\"id\": \"H3\", \"label\": \"Model of a specific real monument, for example a victory or memorial column\", \"confidence\": 0.1, \"supports\": [\"E3\"], \"weakens\": [\"E8\"], \"alternative_to\": [\"H4\"], \"specializes\": \"H2\", \"candidate\": {\"label\": null, \"kind\": \"none\", \"wikidata_search_term\": null}}, {\"id\": \"H4\", \"label\": \"Free design without a specific real-world model\", \"confidence\": 0.4, \"supports\": [\"E4\", \"E5\"], \"weakens\": [], \"alternative_to\": [\"H3\"], \"specializes\": null, \"candidate\": {\"label\": null, \"kind\": \"none\", \"wikidata_search_term\": null}}, {\"id\": \"H5\", \"label\": \"Minifigure display stand or podium, with the stepped pyramid only as a pedestal\", \"confidence\": 0.2, \"supports\": [\"E3\", \"E8\"], \"weakens\": [\"E1\"], \"alternative_to\": [\"H2\"], \"specializes\": \"H1\", \"candidate\": {\"label\": \"display stand for minifigure\", \"kind\": \"type\", \"wikidata_search_term\": \"minifigure\"}}], \"questions_for_owner\": [\"Is the model based on a real monument or building, and if so which one?\", \"Is it an official kit, a MOC (own creation) or a digital assembly, and in which software was it made?\", \"What do the figure and the helmet represent, for example a character, a soldier or a ruler?\", \"Which scale applies, in particular the real size of the studs in the file units?\"], \"notes\": \"Hypotheses overlap and need not sum to 1. The scale estimate assumes standard 8 mm stud pitch and is uncertain. The side views show about seven steps, which agrees with the 7 plateaus in the facts.\"}"^^rdf:JSON .

ex:modelB_H2 a lrec:IdentityHypothesis ;
    rdfs:label "Monument or column on a stepped base with a statue of a warrior or soldier on top"@en ;
    prov:wasAttributedTo ex:modelB_interpreter ;
    prov:wasGeneratedBy ex:modelB_ident ;
    lrec:confidence 0.3 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:modelB_object ;
    lrec:proposesReferent ex:modelB_C2 ;
    lrec:specializes ex:modelB_H1 ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

ex:modelB_interpreter a lrec:AIAssistant ;
    rdfs:label "Claude"@en ;
    dct:identifier "claude-sonnet-5-5" ;
    rdfs:comment "Self-reported model identifier; may differ from the serving model. Context: fresh session, no prior knowledge; analysis from contact sheet and facts only"@en .

ex:modelB_object a crm:E18_Physical_Thing ;
    rdfs:label "Object shown by modelB"@en ;
    dct:description "Rectangular stepped pyramid built from light grey studded bricks, with a narrow one-stud-wide column rising from the centre and a small minifigure-like figure with a grey helmet and tan tunic standing on top."@en ;
    dct:format "brick_built_toy" ;
    dct:medium "plastic building bricks (appearance only; material not verifiable)"@en ;
    dct:type "scene_or_assembly" ;
    crm:P43_has_dimension ex:modelB_levels,
        ex:modelB_size ;
    crm:P46_is_composed_of ex:modelB_P1,
        ex:modelB_P2,
        ex:modelB_P3,
        ex:modelB_P4 ;
    rdfs:comment "Overall shape: stepped taper (rectangular stepped pyramid) with a slender central column and a small figure on the very top. Mirror axes: a, b; rotational fold: 2."@en .

ex:modelB_H1 a lrec:IdentityHypothesis ;
    rdfs:label "Brick-built stepped pyramid with a central pillar and a figure on top, a toy or display model"@en ;
    prov:wasAttributedTo ex:modelB_interpreter ;
    prov:wasGeneratedBy ex:modelB_ident ;
    lrec:confidence 0.7 ;
    lrec:confidenceBasis "subjective estimate by the AI assistant from views and facts, not a measurement"@en ;
    lrec:hypothesisAbout ex:modelB_object ;
    lrec:proposesReferent ex:modelB_C1 ;
    lrec:verificationStatus "open: confirmation by the owner needed"@en .

